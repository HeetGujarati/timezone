# Canonical origin for this site. MUST be set before the first production build,
# or canonicals, hreflang and sitemaps will point at the wrong host.
# No trailing slash.
PUBLIC_SITE_URL="https://meridiem.app"

# Ad slots render nothing unless this is exactly "true". Leave false until an
# AdSense publisher ID is in ads.txt and a certified CMP is live for EEA/UK traffic.
PUBLIC_ADS_ENABLED="false"

# Cookieless Cloudflare Web Analytics token. Leave empty to ship no analytics at all.
PUBLIC_CF_ANALYTICS_TOKEN=""
