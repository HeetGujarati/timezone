# Security headers for Cloudflare Pages and Netlify.
#
# script-src is rewritten at build time by src/integrations/csp-hashes.ts, which
# replaces the placeholder below with 'self' plus a SHA-256 hash for every inline
# script actually present in the build. The policy therefore carries no
# 'unsafe-inline' and no 'unsafe-eval', and cannot silently acquire either.
#
# Verify after deploying:
#   curl -sI https://your-domain/ | grep -i content-security-policy

/*
  Content-Security-Policy: default-src 'none'; script-src __CSP_SCRIPT_SRC__; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  X-Frame-Options: DENY

# Hashed asset filenames are immutable: cache them for a year.
/_assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts are hashed too, and cross-origin isolated.
/_assets/*.woff2
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: font/woff2

# HTML is rebuilt monthly; revalidate rather than serve a stale offset table.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/sitemap-index.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600
