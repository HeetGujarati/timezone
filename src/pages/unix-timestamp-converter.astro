---
import ToolPage from '~/templates/ToolPage.astro';
import ZoneSelect from '~/components/ZoneSelect.astro';
import { useTranslations } from '~/lib/i18n/index.ts';
import { BUILD_DATE_UTC } from '~/config/build.ts';

const locale = 'en' as const;
const t = useTranslations(locale);

const landmarks = [
  {
    epoch: 0,
    label: 'The Unix epoch',
    iso: '1970-01-01T00:00:00Z',
    note: 'Where the count starts.',
  },
  {
    epoch: 1_000_000_000,
    label: 'One billion seconds',
    iso: '2001-09-09T01:46:40Z',
    note: 'Celebrated by a generation of engineers at their desks.',
  },
  {
    epoch: 1_234_567_890,
    label: 'The counting-up timestamp',
    iso: '2009-02-13T23:31:30Z',
    note: 'Nine consecutive digits, once.',
  },
  {
    epoch: 2_147_483_647,
    label: 'The 2038 problem',
    iso: '2038-01-19T03:14:07Z',
    note: 'The last second a signed 32-bit integer can hold. One tick later it goes negative.',
  },
  {
    epoch: 4_102_444_800,
    label: 'The year 2100',
    iso: '2100-01-01T00:00:00Z',
    note: 'Still comfortably inside a 64-bit count.',
  },
];

const faqs = [
  {
    question: 'Seconds or milliseconds — how does it know?',
    answer:
      'By size. A timestamp of 1e11 or more is treated as milliseconds, because 1e11 seconds is the year 5138 and nothing real reaches it. The detected unit is shown next to the result rather than applied silently, because guessing wrong is a factor-of-1000 error that lands you in 1970.',
  },
  {
    question: 'What is a Unix timestamp?',
    answer:
      'The number of seconds since 1 January 1970 at 00:00:00 UTC, not counting leap seconds. It is a single number with no time zone attached, which is exactly why systems use it: two machines anywhere on earth reading the same timestamp agree on the same instant.',
  },
  {
    question: 'Can a timestamp be negative?',
    answer:
      'Yes. Anything before 1970 is negative. The Apollo 11 landing is roughly -14,182,940. This converter handles negative values in both directions.',
  },
  {
    question: 'What happens in 2038?',
    answer:
      'Systems storing the count in a signed 32-bit integer run out of room at 03:14:07 UTC on 19 January 2038. The next second overflows to a negative number, which those systems read as December 1901. Most modern platforms moved to 64-bit counts years ago; embedded and legacy systems are the ones still exposed.',
  },
  {
    question: 'Does the time zone affect the timestamp?',
    answer:
      'Not the timestamp itself — it is always counted from a UTC instant. The zone only decides how that instant is displayed as a date and time, and which local reading converts back to which number.',
  },
];
---

<ToolPage
  locale={locale}
  path="/unix-timestamp-converter/"
  title="Unix timestamp converter"
  metaTitle="Unix timestamp converter — epoch to date, both ways"
  description="Convert a Unix timestamp to a human date and back, in any time zone. Detects seconds versus milliseconds and shows a live epoch counter."
  keywords={['unix timestamp converter', 'epoch converter', 'epoch time', 'timestamp to date']}
  summary="Paste a Unix timestamp to read it as a date, or pick a date to get the timestamp — the converter detects whether your number is in seconds or milliseconds and tells you which it assumed."
  faqs={faqs}
  featureList={[
    'Epoch to date and date to epoch',
    'Automatic second and millisecond detection',
    'Live epoch counter',
    'Any IANA time zone',
  ]}
>
  <epoch-converter
    slot="tool"
    class="block rounded-[var(--radius-lg)] border border-[var(--color-rule)] bg-[var(--color-surface-raised)] p-4 md:p-6"
    data-locale={locale}
    data-unit-s="seconds"
    data-unit-ms="milliseconds"
    data-error-number="Enter a whole number — a Unix timestamp has no decimal point."
    data-error-range="That timestamp is outside the range a date can represent."
  >
    <div class="grid gap-4 md:grid-cols-2">
      <div class="flex flex-col gap-1">
        <label
          for="epoch-value"
          class="text-[length:var(--text-sm)] font-medium text-[var(--color-text-muted)]"
        >
          {t('epoch.toHuman')}
        </label>
        <input
          id="epoch-value"
          data-role="epoch"
          type="text"
          inputmode="numeric"
          autocomplete="off"
          class="w-full rounded-[var(--radius-md)] border border-[var(--color-rule)] bg-[var(--color-surface)] px-3 py-2 font-[family-name:var(--font-mono)]"
        />
      </div>
      <ZoneSelect id="epoch-zone" name="zone" label={t('common.to')} value="UTC" />
    </div>

    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      <div class="flex flex-col gap-1">
        <label
          for="epoch-date"
          class="text-[length:var(--text-sm)] font-medium text-[var(--color-text-muted)]"
        >
          {t('common.date')}
        </label>
        <input
          id="epoch-date"
          data-role="date"
          type="date"
          value={BUILD_DATE_UTC}
          class="w-full rounded-[var(--radius-md)] border border-[var(--color-rule)] bg-[var(--color-surface)] px-3 py-2 font-[family-name:var(--font-mono)]"
        />
      </div>
      <div class="flex flex-col gap-1">
        <label
          for="epoch-time"
          class="text-[length:var(--text-sm)] font-medium text-[var(--color-text-muted)]"
        >
          {t('common.time')}
        </label>
        <input
          id="epoch-time"
          data-role="time"
          type="time"
          step="1"
          value="00:00:00"
          class="w-full rounded-[var(--radius-md)] border border-[var(--color-rule)] bg-[var(--color-surface)] px-3 py-2 font-[family-name:var(--font-mono)]"
        />
      </div>
    </div>

    <button
      type="button"
      data-role="now"
      hidden
      class="mt-3 rounded-[var(--radius-md)] border border-[var(--color-rule)] px-3 py-1.5 text-[length:var(--text-sm)] text-[var(--color-text-muted)] hover:text-[var(--color-text)]"
    >
      {t('common.now')}
    </button>

    <p
      data-role="error"
      hidden
      role="alert"
      class="mt-3 text-[length:var(--text-sm)] text-[var(--color-signal)]"
    >
    </p>

    <div
      aria-live="polite"
      class="mt-5 rounded-[var(--radius-md)] bg-[var(--color-surface-sunken)] p-4"
    >
      <p
        class="text-[length:var(--text-xs)] tracking-wide text-[var(--color-text-muted)] uppercase"
      >
        {t('common.result')}
      </p>
      <p data-out="time" class="tabular mt-1 text-[length:var(--text-2xl)] font-semibold">—</p>
      <p data-out="date" class="tabular mt-1 text-[length:var(--text-sm)]">—</p>
      <p
        data-out="iso"
        class="tabular mt-2 text-[length:var(--text-xs)] text-[var(--color-text-muted)]"
      >
        —
      </p>
      <p class="mt-2 text-[length:var(--text-xs)] text-[var(--color-text-muted)]">
        Read as <span data-out="unit" class="font-semibold">seconds</span>
      </p>
    </div>

    <div data-role="live-epoch" class="mt-4 flex flex-wrap gap-6 text-[length:var(--text-sm)]">
      <p>
        <span class="block text-[length:var(--text-xs)] text-[var(--color-text-muted)]">
          {t('epoch.currentEpoch')} ({t('epoch.seconds')})
        </span>
        <span data-out="live-seconds" class="tabular font-semibold">—</span>
      </p>
      <p>
        <span class="block text-[length:var(--text-xs)] text-[var(--color-text-muted)]">
          {t('epoch.currentEpoch')} ({t('epoch.milliseconds')})
        </span>
        <span data-out="live-millis" class="tabular font-semibold">—</span>
      </p>
    </div>
  </epoch-converter>

  <section class="mt-12">
    <h2 class="text-[length:var(--text-2xl)]">Timestamps worth knowing</h2>
    <p class="prose mt-2 text-[var(--color-text-muted)]">
      Fixed points in the count. These do not change, so they are part of the page rather than
      something your browser has to compute.
    </p>
    <div class="mt-4 overflow-x-auto">
      <table class="w-full min-w-[38rem] text-[length:var(--text-sm)]">
        <thead>
          <tr class="border-b border-[var(--color-rule)] text-left text-[var(--color-text-muted)]">
            <th scope="col" class="py-2 pr-4 font-medium">Timestamp</th>
            <th scope="col" class="py-2 pr-4 font-medium">UTC</th>
            <th scope="col" class="py-2 font-medium">What it is</th>
          </tr>
        </thead>
        <tbody>
          {
            landmarks.map((landmark) => (
              <tr class="border-b border-[var(--color-rule)]">
                <td class="tabular py-2 pr-4">{landmark.epoch}</td>
                <td class="tabular py-2 pr-4">{landmark.iso}</td>
                <td class="py-2">
                  <span class="font-medium">{landmark.label}</span>{' '}
                  <span class="text-[var(--color-text-muted)]">{landmark.note}</span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <script>
    import '~/islands/epoch.ts';
  </script>
</ToolPage>
