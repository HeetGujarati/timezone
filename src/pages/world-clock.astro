---
import ToolPage from '~/templates/ToolPage.astro';
import LiveClock from '~/components/LiveClock.astro';
import { CITIES } from '~/data/cities.ts';
import { BUILD_INSTANT } from '~/config/build.ts';
import { useTranslations } from '~/lib/i18n/index.ts';
import { localePath } from '~/config/locales.ts';
import { formatOffsetShort, getOffsetMinutes } from '~/lib/time/offset.ts';

const locale = 'en' as const;
const t = useTranslations(locale);

// Ordered east to west by standard offset, so the grid reads like a map.
const cities = [...CITIES].sort((a, b) => {
  const offsetDiff =
    getOffsetMinutes(b.timeZone, BUILD_INSTANT) - getOffsetMinutes(a.timeZone, BUILD_INSTANT);
  return offsetDiff !== 0 ? offsetDiff : a.name.localeCompare(b.name, 'en');
});

const faqs = [
  {
    question: 'How accurate are these clocks?',
    answer:
      'They read your device clock and apply the offset your browser gets from the IANA time zone database, so they are as accurate as your own machine. If your computer clock is wrong, every clock here is wrong by the same amount — nothing on this page comes from a server.',
  },
  {
    question: 'Can I keep my cities at the top?',
    answer:
      'Yes. Pin any city and it moves to the front of the grid and stays there on your next visit. Pins live in your browser only; nothing is sent anywhere and no cookie is set.',
  },
  {
    question: 'Why are some cities showing a different date?',
    answer:
      'Because they are. When it is Monday evening in New York it is already Tuesday morning in Tokyo. The date under each clock is the local calendar date in that city, not yours.',
  },
  {
    question: 'Why do Mumbai and Kathmandu show times ending in :30 and :45?',
    answer:
      'India runs at UTC+05:30 and Nepal at UTC+05:45. Those are the real offsets, not rounding errors — around a fifth of the world lives on an offset that is not a whole number of hours.',
  },
];
---

<ToolPage
  locale={locale}
  path="/world-clock/"
  title="World clock"
  metaTitle="World clock — live times in 80 cities"
  description="Live local time in 80 major cities, ordered east to west. Search any city, pin the ones you care about, and see the date roll over as you go."
  keywords={['world clock', 'current time', 'local time', 'time around the world']}
  summary="Live local time in 80 cities, ordered from the earliest clock on earth to the latest — search to narrow it, pin the cities you check often and they stay at the top."
  faqs={faqs}
  featureList={[
    'Live clocks for 80 cities',
    'Search by city, country or former name',
    'Pinned cities persist locally',
  ]}
>
  <world-clock
    slot="tool"
    class="block"
    data-pin-label={t('worldclock.pin')}
    data-unpin-label={t('worldclock.unpin')}
  >
    <div class="max-w-sm">
      <label
        for="world-search"
        class="block text-[length:var(--text-sm)] font-medium text-[var(--color-text-muted)]"
      >
        {t('worldclock.search')}
      </label>
      <input
        id="world-search"
        data-role="search"
        type="search"
        autocomplete="off"
        class="mt-1 w-full rounded-[var(--radius-md)] border border-[var(--color-rule)] bg-[var(--color-surface-raised)] px-3 py-2"
      />
    </div>

    <p data-role="empty" hidden class="mt-4 text-[var(--color-text-muted)]">
      {t('worldclock.noResults')}
    </p>

    <ul class="mt-6 flex flex-wrap gap-3">
      {
        cities.map((city) => (
          <li
            data-city={city.slug}
            data-search={[city.name, city.country, ...city.aliases].join(' ')}
            class="flex min-w-[9.5rem] flex-1 flex-col rounded-[var(--radius-md)] border border-[var(--color-rule)] bg-[var(--color-surface-raised)] p-3 data-[pinned=true]:border-[var(--color-accent)]"
          >
            <div class="flex items-start justify-between gap-2">
              <a
                href={localePath(locale, `/time-in/${city.slug}/`)}
                class="text-[length:var(--text-sm)] font-medium text-[var(--color-text)] no-underline hover:underline"
              >
                {city.name}
              </a>
              <button
                type="button"
                data-role="pin"
                hidden
                aria-pressed="false"
                class="text-[length:var(--text-sm)] text-[var(--color-text-muted)] hover:text-[var(--color-accent)]"
              >
                <span aria-hidden="true">◆</span>
              </button>
            </div>
            <LiveClock locale={locale} timeZone={city.timeZone} showDate size="lg" class="mt-2" />
            <span class="mt-1 text-[length:var(--text-2xs)] text-[var(--color-text-muted)]">
              {city.country} · {formatOffsetShort(getOffsetMinutes(city.timeZone, BUILD_INSTANT))}
            </span>
          </li>
        ))
      }
    </ul>

    <noscript>
      <p class="mt-4 text-[length:var(--text-sm)] text-[var(--color-text-muted)]">
        {t('clock.needsJs')}
      </p>
    </noscript>
  </world-clock>

  <script>
    import '~/islands/world-clock.ts';
  </script>
</ToolPage>
