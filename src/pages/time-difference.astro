---
import ToolPage from '~/templates/ToolPage.astro';
import ZoneSelect from '~/components/ZoneSelect.astro';
import { useTranslations } from '~/lib/i18n/index.ts';
import { CURRENT_YEAR } from '~/config/build.ts';
import { findDstTransitions } from '~/lib/time/dst.ts';
import { getOffsetMinutes } from '~/lib/time/offset.ts';
import { describeDifference } from '~/lib/time/convert.ts';

const locale = 'en' as const;
const t = useTranslations(locale);

/**
 * A worked example, computed at build time from the real transition dates for the
 * pair most people search for. It is durable data, not a live reading.
 */
const EXAMPLE_FROM = 'America/New_York';
const EXAMPLE_TO = 'Europe/London';

const exampleChanges = [CURRENT_YEAR, CURRENT_YEAR + 1]
  .flatMap((year) => [
    ...findDstTransitions(EXAMPLE_FROM, year).map((transition) => transition.instant),
    ...findDstTransitions(EXAMPLE_TO, year).map((transition) => transition.instant),
  ])
  .sort((a, b) => a - b)
  .reduce<{ instant: number; difference: number }[]>((accumulated, instant) => {
    const difference =
      getOffsetMinutes(EXAMPLE_TO, instant) - getOffsetMinutes(EXAMPLE_FROM, instant);
    const previous = accumulated[accumulated.length - 1];
    if (previous === undefined || previous.difference !== difference) {
      accumulated.push({ instant, difference });
    }
    return accumulated;
  }, [])
  .slice(0, 6)
  .map((entry) => ({
    date: new Date(entry.instant).toISOString().slice(0, 10),
    description: describeDifference(entry.difference),
  }));

const faqs = [
  {
    question: 'Why is the difference not the same all year?',
    answer:
      'Because the two places change their clocks on different dates, or one of them does not change at all. New York and London are 5 hours apart for most of the year, 4 hours apart for the three weeks in March after the United States springs forward but before Europe does, and 4 hours apart again for the week in late October after Europe falls back but before the United States does.',
  },
  {
    question: 'Which places never change the difference?',
    answer:
      'Any pair where neither observes daylight saving — India and Japan, for instance, are permanently 3 hours 30 minutes apart. Pairs inside the same regulatory bloc are also stable: every European Union zone changes at the same instant, so Lisbon and Athens stay exactly 2 hours apart all year.',
  },
  {
    question: 'How is the difference calculated?',
    answer:
      'By asking your browser for each zone offset at the same instant and subtracting. That means it is correct at the moment you look at it, including in the middle of a change-over, rather than reading a stored number that was true last month.',
  },
  {
    question: 'What does a negative difference mean?',
    answer:
      'It means the second place is behind the first. The page says "ahead" or "behind" in words for exactly that reason — minus signs on time differences are read backwards by roughly half of everyone.',
  },
];
---

<ToolPage
  locale={locale}
  path="/time-difference/"
  title="Time difference"
  metaTitle="Time difference between any two time zones"
  description="See the current difference between two places, and every date in the next year when that difference changes because one of them shifts its clocks."
  keywords={[
    'time difference',
    'time difference calculator',
    'hours between time zones',
    'time zone gap',
  ]}
  summary="Pick two places and this shows how far apart they are right now — plus the exact dates over the next year when that gap changes, which is the part most tools leave out."
  faqs={faqs}
  featureList={[
    'Live difference between any two zones',
    'Every upcoming date the difference changes',
    'Local time in both places at once',
  ]}
>
  <zone-difference
    slot="tool"
    class="block rounded-[var(--radius-lg)] border border-[var(--color-rule)] bg-[var(--color-surface-raised)] p-4 md:p-6"
    data-locale={locale}
  >
    <div class="grid gap-4 md:grid-cols-2">
      <ZoneSelect id="difference-from" name="from" label={t('common.from')} value={EXAMPLE_FROM} />
      <ZoneSelect id="difference-to" name="to" label={t('common.to')} value={EXAMPLE_TO} />
    </div>

    <button
      type="button"
      data-role="swap"
      hidden
      class="mt-3 rounded-[var(--radius-md)] border border-[var(--color-rule)] px-3 py-1.5 text-[length:var(--text-sm)] text-[var(--color-text-muted)] hover:text-[var(--color-text)]"
    >
      {t('converter.swap')}
    </button>

    <div
      aria-live="polite"
      class="mt-5 rounded-[var(--radius-md)] bg-[var(--color-surface-sunken)] p-4"
    >
      <p data-out="headline" class="text-[length:var(--text-2xl)] font-semibold">—</p>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <div>
          <p data-out="from-time" class="tabular text-[length:var(--text-xl)] font-semibold">—</p>
          <p data-out="from-date" class="tabular text-[length:var(--text-sm)]">—</p>
          <p
            data-out="from-zone"
            class="tabular text-[length:var(--text-xs)] text-[var(--color-text-muted)]"
          >
            —
          </p>
        </div>
        <div>
          <p data-out="to-time" class="tabular text-[length:var(--text-xl)] font-semibold">—</p>
          <p data-out="to-date" class="tabular text-[length:var(--text-sm)]">—</p>
          <p
            data-out="to-zone"
            class="tabular text-[length:var(--text-xs)] text-[var(--color-text-muted)]"
          >
            —
          </p>
        </div>
      </div>
    </div>

    <div class="mt-6">
      <h2 class="text-[length:var(--text-lg)]">When this difference changes</h2>
      <ul data-role="changes" class="mt-2 text-[length:var(--text-sm)]"></ul>
      <p
        data-role="changes-empty"
        hidden
        class="mt-2 text-[length:var(--text-sm)] text-[var(--color-text-muted)]"
      >
        Neither place changes its clocks, so this difference is the same all year.
      </p>
    </div>
  </zone-difference>

  <section class="mt-12">
    <h2 class="text-[length:var(--text-2xl)]">A worked example: New York and London</h2>
    <p class="prose mt-2 text-[var(--color-text-muted)]">
      The most-searched pair on the internet, and a good illustration of why "five hours" is a
      half-truth. These dates come from the IANA database at build time — they are fixed facts, not
      a live reading.
    </p>
    <ul class="mt-4 text-[length:var(--text-sm)]">
      {
        exampleChanges.map((change) => (
          <li class="flex flex-wrap justify-between gap-2 border-b border-[var(--color-rule)] py-2">
            <span class="tabular">From {change.date}</span>
            <span class="text-[var(--color-text-muted)]">
              London is {change.description} of New York
            </span>
          </li>
        ))
      }
    </ul>
    <p class="prose mt-4 text-[length:var(--text-sm)] text-[var(--color-text-muted)]">
      {t('note.exampleTimestamp')}
    </p>
  </section>

  <script>
    import '~/islands/difference.ts';
  </script>
</ToolPage>
