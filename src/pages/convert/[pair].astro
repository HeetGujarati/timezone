---
import PairPage from '~/templates/PairPage.astro';
import { rankedPairs } from '~/data/pairs.ts';
import { localesForPath } from '~/config/rollout.ts';
import type { GetStaticPaths } from 'astro';

/**
 * English city-pair pages. Every path comes from the generated pair set, so a URL
 * outside that allowlist simply does not exist and 404s — there is no dynamic
 * parameter to validate at runtime because there is no runtime.
 */
export const getStaticPaths = (() =>
  rankedPairs().map((pair, rank) => ({
    params: { pair: pair.slug },
    // The rank decides whether this pair is in the localised launch subset.
    props: { pair, rank },
  }))) satisfies GetStaticPaths;

const { pair, rank } = Astro.props;
const availableLocales = localesForPath(`/convert/${pair.slug}/`, { pairRank: rank });
---

<PairPage pair={pair} locale="en" availableLocales={availableLocales} />
