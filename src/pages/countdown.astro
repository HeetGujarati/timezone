---
import ToolPage from '~/templates/ToolPage.astro';
import ZoneSelect from '~/components/ZoneSelect.astro';
import { useTranslations } from '~/lib/i18n/index.ts';
import { CURRENT_YEAR } from '~/config/build.ts';

const locale = 'en' as const;
const t = useTranslations(locale);

const faqs = [
  {
    question: 'How do I share a countdown?',
    answer:
      'Set it up and copy the address bar — every field is in the URL. Whoever opens it sees the same countdown to the same instant, counted down in their own device clock. There is no account, no saved record and nothing stored on a server, because there is no server.',
  },
  {
    question: 'Does the recipient see it in their own time zone?',
    answer:
      'They see the same countdown, because a countdown measures a distance to one instant and that distance is the same everywhere. The target date and time are shown in the zone you chose, so everyone can see which local moment it refers to.',
  },
  {
    question: 'What happens when it reaches zero?',
    answer:
      'It says the moment has passed and stops. It does not start counting up — if you want elapsed time since an event, the duration calculator answers that properly.',
  },
  {
    question: 'Can I count down to a time that does not exist?',
    answer:
      'If you pick a local time inside a spring-forward gap, the countdown moves to the equivalent instant after the change and tells you. That is the same policy every tool on this site uses.',
  },
];
---

<ToolPage
  locale={locale}
  path="/countdown/"
  title="Countdown"
  metaTitle="Countdown timer to any date and time zone"
  description="Count down to any moment in any time zone, and share it as a link. No account, no storage — the whole countdown lives in the URL."
  keywords={['countdown timer', 'countdown to date', 'shareable countdown', 'days until']}
  summary="Pick a moment and a zone, and the countdown below runs to it — the whole thing lives in the URL, so copying the address bar is how you share it."
  faqs={faqs}
  featureList={[
    'Counts down to any instant',
    'Shareable entirely through the URL',
    'Any IANA time zone',
    'Nothing stored anywhere',
  ]}
>
  <countdown-timer
    slot="tool"
    class="block rounded-[var(--radius-lg)] border border-[var(--color-rule)] bg-[var(--color-surface-raised)] p-4 md:p-6"
    data-locale={locale}
    data-copied-label={t('common.copied')}
  >
    <div class="grid gap-4 md:grid-cols-2">
      <div class="flex flex-col gap-1">
        <label
          for="countdown-title"
          class="text-[length:var(--text-sm)] font-medium text-[var(--color-text-muted)]"
        >
          {t('countdown.title')}
        </label>
        <input
          id="countdown-title"
          data-role="title"
          type="text"
          maxlength="80"
          autocomplete="off"
          value="Launch"
          class="w-full rounded-[var(--radius-md)] border border-[var(--color-rule)] bg-[var(--color-surface)] px-3 py-2"
        />
      </div>
      <ZoneSelect id="countdown-zone" name="zone" label="Zone" value="UTC" />
    </div>

    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      <div class="flex flex-col gap-1">
        <label
          for="countdown-date"
          class="text-[length:var(--text-sm)] font-medium text-[var(--color-text-muted)]"
        >
          {t('common.date')}
        </label>
        <input
          id="countdown-date"
          data-role="date"
          type="date"
          value={`${CURRENT_YEAR + 1}-01-01`}
          class="w-full rounded-[var(--radius-md)] border border-[var(--color-rule)] bg-[var(--color-surface)] px-3 py-2 font-[family-name:var(--font-mono)]"
        />
      </div>
      <div class="flex flex-col gap-1">
        <label
          for="countdown-time"
          class="text-[length:var(--text-sm)] font-medium text-[var(--color-text-muted)]"
        >
          {t('common.time')}
        </label>
        <input
          id="countdown-time"
          data-role="time"
          type="time"
          value="00:00"
          class="w-full rounded-[var(--radius-md)] border border-[var(--color-rule)] bg-[var(--color-surface)] px-3 py-2 font-[family-name:var(--font-mono)]"
        />
      </div>
    </div>

    <button
      type="button"
      data-role="share"
      hidden
      class="mt-3 rounded-[var(--radius-md)] border border-[var(--color-rule)] px-3 py-1.5 text-[length:var(--text-sm)] text-[var(--color-text-muted)] hover:text-[var(--color-text)]"
    >
      {t('countdown.share')}
    </button>

    <p
      data-role="error"
      hidden
      role="alert"
      class="mt-3 text-[length:var(--text-sm)] text-[var(--color-signal)]"
    >
    </p>

    <div
      aria-live="polite"
      class="mt-6 rounded-[var(--radius-md)] bg-[var(--color-surface-sunken)] p-5 text-center"
    >
      <p data-out="title" class="text-[length:var(--text-lg)] font-semibold"></p>
      <p class="mt-1 text-[length:var(--text-sm)] text-[var(--color-text-muted)]">
        {t('countdown.target')}
        <span data-out="target" class="tabular">—</span>
      </p>

      <div class="mt-4 flex justify-center gap-4 sm:gap-8">
        {
          (['days', 'hours', 'minutes', 'seconds'] as const).map((unit) => (
            <div>
              <span
                data-out={unit}
                class="tabular block text-[length:var(--text-3xl)] leading-none font-semibold"
              >
                —
              </span>
              <span class="mt-1 block text-[length:var(--text-2xs)] tracking-wide text-[var(--color-text-muted)] uppercase">
                {unit}
              </span>
            </div>
          ))
        }
      </div>

      <p data-role="finished" hidden class="mt-4 text-[var(--color-signal)]">
        {t('countdown.finished')}
      </p>
    </div>
  </countdown-timer>

  <section class="prose mt-12">
    <h2 class="text-[length:var(--text-2xl)]">Why the whole countdown is in the link</h2>
    <p class="mt-3 text-[var(--color-text-muted)]">
      Most countdown tools ask you to make an account so they can store your countdown on their
      server and show you an advert next to it. There is no server here, so the state has to live
      somewhere the link can carry it — which turns out to be better for everyone. Nothing to sign
      up for, nothing to delete later, nothing that stops working when a company shuts down.
    </p>
    <p class="mt-4 text-[var(--color-text-muted)]">
      The one thing worth knowing: because the title travels in the URL, treat a countdown link from
      a stranger the way you would any link. The title is stripped of anything that is not plain
      text and rendered as text, never as markup.
    </p>
  </section>

  <script>
    import '~/islands/countdown.ts';
  </script>
</ToolPage>
