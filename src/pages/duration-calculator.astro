---
import ToolPage from '~/templates/ToolPage.astro';
import ZoneSelect from '~/components/ZoneSelect.astro';
import { useTranslations } from '~/lib/i18n/index.ts';
import { BUILD_DATE_UTC } from '~/config/build.ts';

const locale = 'en' as const;
const t = useTranslations(locale);

const faqs = [
  {
    question: 'Why does a day sometimes come out as 23 or 25 hours?',
    answer:
      'Because it was. On the day clocks spring forward, midnight to midnight is 23 hours; on the day they fall back it is 25. This calculator resolves both ends to absolute instants before subtracting, so it reports the time that actually passed rather than the time the calendar suggests.',
  },
  {
    question: 'Can the two ends be in different time zones?',
    answer:
      'Yes, and that is the point. A flight leaving Tokyo at 17:00 and landing in San Francisco at 09:30 the same morning took nine and a half hours, not minus seven and a half. Set each end to its own zone and the arithmetic works out.',
  },
  {
    question: 'Are leap seconds included?',
    answer:
      'No. Browsers do not expose them — the JavaScript clock ignores leap seconds entirely, so a span crossing one is reported a second short. Over the whole history of UTC that is 27 seconds in total, which matters for satellite navigation and for nothing you are likely to be measuring here.',
  },
  {
    question: 'What if the end is before the start?',
    answer:
      'It says so, and reports the magnitude anyway. A negative duration is usually a typo, and silently flipping the sign would hide it.',
  },
];
---

<ToolPage
  locale={locale}
  path="/duration-calculator/"
  title="Duration calculator"
  metaTitle="Duration calculator across time zones"
  description="Work out the time between two date-times, each in its own zone. Handles daylight saving correctly, so a 23-hour day is reported as 23 hours."
  keywords={[
    'duration calculator',
    'time between dates',
    'elapsed time calculator',
    'hours between two times',
  ]}
  summary="Set a start and an end — each in its own time zone if they differ — and this reports the time that actually elapsed, including the days that are 23 or 25 hours long."
  faqs={faqs}
  featureList={[
    'Different zone at each end',
    'Daylight-saving-correct arithmetic',
    'Totals in days, hours, minutes and seconds',
  ]}
>
  <duration-calculator
    slot="tool"
    class="block rounded-[var(--radius-lg)] border border-[var(--color-rule)] bg-[var(--color-surface-raised)] p-4 md:p-6"
    data-locale={locale}
    data-label-before="The end is before the start — the figure below is how far apart they are."
  >
    <fieldset class="border-0 p-0">
      <legend class="text-[length:var(--text-sm)] font-semibold">{t('duration.start')}</legend>
      <div class="mt-2 grid gap-3 md:grid-cols-3">
        <div class="flex flex-col gap-1">
          <label
            for="duration-start-date"
            class="text-[length:var(--text-sm)] text-[var(--color-text-muted)]"
          >
            {t('common.date')}
          </label>
          <input
            id="duration-start-date"
            data-role="start-date"
            type="date"
            value={BUILD_DATE_UTC}
            class="rounded-[var(--radius-md)] border border-[var(--color-rule)] bg-[var(--color-surface)] px-3 py-2 font-[family-name:var(--font-mono)]"
          />
        </div>
        <div class="flex flex-col gap-1">
          <label
            for="duration-start-time"
            class="text-[length:var(--text-sm)] text-[var(--color-text-muted)]"
          >
            {t('common.time')}
          </label>
          <input
            id="duration-start-time"
            data-role="start-time"
            type="time"
            value="09:00"
            class="rounded-[var(--radius-md)] border border-[var(--color-rule)] bg-[var(--color-surface)] px-3 py-2 font-[family-name:var(--font-mono)]"
          />
        </div>
        <ZoneSelect id="duration-start-zone" name="start-zone" label="Zone" value="UTC" />
      </div>
    </fieldset>

    <fieldset class="mt-6 border-0 p-0">
      <legend class="text-[length:var(--text-sm)] font-semibold">{t('duration.end')}</legend>
      <div class="mt-2 grid gap-3 md:grid-cols-3">
        <div class="flex flex-col gap-1">
          <label
            for="duration-end-date"
            class="text-[length:var(--text-sm)] text-[var(--color-text-muted)]"
          >
            {t('common.date')}
          </label>
          <input
            id="duration-end-date"
            data-role="end-date"
            type="date"
            value={BUILD_DATE_UTC}
            class="rounded-[var(--radius-md)] border border-[var(--color-rule)] bg-[var(--color-surface)] px-3 py-2 font-[family-name:var(--font-mono)]"
          />
        </div>
        <div class="flex flex-col gap-1">
          <label
            for="duration-end-time"
            class="text-[length:var(--text-sm)] text-[var(--color-text-muted)]"
          >
            {t('common.time')}
          </label>
          <input
            id="duration-end-time"
            data-role="end-time"
            type="time"
            value="17:30"
            class="rounded-[var(--radius-md)] border border-[var(--color-rule)] bg-[var(--color-surface)] px-3 py-2 font-[family-name:var(--font-mono)]"
          />
        </div>
        <ZoneSelect id="duration-end-zone" name="end-zone" label="Zone" value="UTC" />
      </div>
    </fieldset>

    <p
      data-role="error"
      hidden
      role="alert"
      class="mt-3 text-[length:var(--text-sm)] text-[var(--color-signal)]"
    >
    </p>

    <div
      aria-live="polite"
      class="mt-6 rounded-[var(--radius-md)] bg-[var(--color-surface-sunken)] p-4"
    >
      <p
        class="text-[length:var(--text-xs)] tracking-wide text-[var(--color-text-muted)] uppercase"
      >
        {t('duration.result')}
      </p>
      <p data-out="headline" class="tabular mt-1 text-[length:var(--text-2xl)] font-semibold">—</p>
      <p data-out="direction" class="mt-2 text-[length:var(--text-sm)] text-[var(--color-signal)]">
      </p>
      <dl class="mt-4 grid grid-cols-2 gap-3 text-[length:var(--text-sm)] sm:grid-cols-4">
        <div>
          <dt class="text-[var(--color-text-muted)]">Days</dt>
          <dd data-out="days" class="tabular font-semibold">—</dd>
        </div>
        <div>
          <dt class="text-[var(--color-text-muted)]">Hours</dt>
          <dd data-out="hours" class="tabular font-semibold">—</dd>
        </div>
        <div>
          <dt class="text-[var(--color-text-muted)]">Minutes</dt>
          <dd data-out="minutes" class="tabular font-semibold">—</dd>
        </div>
        <div>
          <dt class="text-[var(--color-text-muted)]">Seconds</dt>
          <dd data-out="seconds" class="tabular font-semibold">—</dd>
        </div>
      </dl>
    </div>
  </duration-calculator>

  <section class="prose mt-12">
    <h2 class="text-[length:var(--text-2xl)]">Why calendar arithmetic is not clock arithmetic</h2>
    <p class="mt-3 text-[var(--color-text-muted)]">
      "One day later" and "24 hours later" are different instructions, and twice a year they give
      different answers. If a nightly job is scheduled for 02:30 local time, it runs twice on one
      autumn morning and not at all on one spring morning. If it is scheduled every 86,400 seconds,
      it drifts an hour away from 02:30 instead.
    </p>
    <p class="mt-4 text-[var(--color-text-muted)]">
      Neither behaviour is a bug; they answer different questions. The trouble starts when the code
      does one and the person expected the other. This calculator always answers the clock question
      — how much time actually passed — and shows the calendar days alongside it.
    </p>
  </section>

  <script>
    import '~/islands/duration.ts';
  </script>
</ToolPage>
