---
import TimeDifferencePage from '~/templates/tools/TimeDifferencePage.astro';
import { PREFIXED_LOCALES, getLocale } from '~/config/locales.ts';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (() =>
  PREFIXED_LOCALES.map((code) => ({
    params: { locale: getLocale(code).segment },
    props: { locale: code },
  }))) satisfies GetStaticPaths;

const { locale } = Astro.props;
---

<TimeDifferencePage locale={locale} />
