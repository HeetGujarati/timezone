---
import { getCollection } from 'astro:content';
import GuidePage from '~/templates/GuidePage.astro';
import { PREFIXED_LOCALES, getLocale, type LocaleCode } from '~/config/locales.ts';
import { entrySlug, findLocaleEntry, isLocaleEntry } from '~/lib/content/entries.ts';
import type { GetStaticPaths } from 'astro';

/**
 * A locale gets its own guide file where one exists and the English one where it
 * does not, so the URL always resolves and the hreflang cluster stays honest.
 */
export const getStaticPaths = (async () => {
  const all = await getCollection('guides');
  const english = all.filter((entry) => isLocaleEntry(entry, 'en'));

  return PREFIXED_LOCALES.flatMap((code: LocaleCode) =>
    english.map((fallback) => {
      const slug = entrySlug(fallback.id);
      const localised = findLocaleEntry(all, code, slug);
      return {
        params: { locale: getLocale(code).segment, guide: slug },
        props: { guide: localised ?? fallback, locale: code, slug, all },
      };
    }),
  );
}) satisfies GetStaticPaths;

const { guide, locale, slug, all } = Astro.props;
---

<GuidePage guide={guide} locale={locale} slug={slug} all={all} />
