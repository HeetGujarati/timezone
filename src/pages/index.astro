---
import ToolPage from '~/templates/ToolPage.astro';
import Converter from '~/components/Converter.astro';
import { BUILD_INSTANT } from '~/config/build.ts';
import { useTranslations } from '~/lib/i18n/index.ts';
import { localePath } from '~/config/locales.ts';
import { getOffsetMinutes, formatOffsetShort } from '~/lib/time/offset.ts';
import { findNextTransition } from '~/lib/time/dst.ts';

const locale = 'en' as const;
const t = useTranslations(locale);

/**
 * Durable facts, computed at build time. None of these is a "current time" — they
 * are the offsets and transition dates that stay true until the tzdata changes, so
 * a prerendered page can state them without going stale between rebuilds.
 */
const POPULAR = [
  'America/New_York',
  'America/Los_Angeles',
  'Europe/London',
  'Europe/Berlin',
  'Asia/Kolkata',
  'Asia/Tokyo',
  'Asia/Singapore',
  'Australia/Sydney',
] as const;

const zoneFacts = POPULAR.map((zone) => {
  const next = findNextTransition(zone, BUILD_INSTANT);
  return {
    zone,
    label: zone.split('/')[1]?.replaceAll('_', ' ') ?? zone,
    offset: formatOffsetShort(getOffsetMinutes(zone, BUILD_INSTANT)),
    nextChange:
      next === null
        ? null
        : {
            date: `${next.localAfter.year}-${String(next.localAfter.month).padStart(2, '0')}-${String(next.localAfter.day).padStart(2, '0')}`,
            direction: next.direction,
            minutes: Math.abs(next.deltaMinutes),
          },
  };
});

const faqs = [
  {
    question: 'Does this converter handle daylight saving time?',
    answer:
      'Yes, and it handles the two awkward days as well. Offsets come from the IANA time zone database through the browser, so a conversion on a change-over date uses the offset that actually applied at that moment, not the one that applies today. If you enter a local time that never happened, or one that happened twice, the converter says so instead of silently picking one.',
  },
  {
    question: 'Why does the time difference between two cities change during the year?',
    answer:
      'Because the two places rarely change their clocks on the same date, and some never change them at all. New York is 5 hours behind London for most of the year but 4 hours behind for two weeks in March, because the United States moves its clocks two to three weeks before Europe does. Always convert against a specific date rather than a remembered offset.',
  },
  {
    question: 'Which time zones can I convert between?',
    answer:
      'Every zone in the IANA database — over 400 of them, including the half-hour and 45-minute offsets that trip up most converters. India at UTC+05:30, Nepal at UTC+05:45 and the Chatham Islands at UTC+12:45 are all handled exactly, not rounded to the nearest hour.',
  },
  {
    question: 'Do I need JavaScript?',
    answer:
      'For the live converter, yes. Everything else on this site — offsets, daylight saving transition dates, hour-by-hour reference tables and every explanation — is part of the prerendered page and works with JavaScript disabled.',
  },
  {
    question: 'Is anything I type here sent anywhere?',
    answer:
      'No. Every calculation happens in your browser. There is no backend, no analytics, no cookies and no third-party script. The zones you pick appear in the URL so you can share or bookmark a conversion, and that is the only place they go.',
  },
];

const howToSteps = [
  {
    name: 'Pick the zone you are converting from',
    text: 'Choose the city or zone where the time you already know is measured.',
    anchor: 'convert-from',
  },
  {
    name: 'Pick the zone you are converting to',
    text: 'Choose the place you want the time expressed in.',
    anchor: 'convert-to',
  },
  {
    name: 'Set the date and time',
    text: 'The date matters: it decides whether daylight saving time applies to either zone.',
    anchor: 'convert-date',
  },
];
---

<ToolPage
  locale={locale}
  path="/"
  title="Time zone converter"
  metaTitle="Time zone converter — convert any zone, any date"
  description="Convert any time zone to any other for any date. DST-aware, accurate to the IANA database, and it handles half-hour and 45-minute offsets exactly."
  keywords={['time zone converter', 'convert time zones', 'time zone calculator', 'time converter']}
  summary="Pick two zones and a date, and this converts between them exactly — including on the two days a year when daylight saving makes a local time either impossible or ambiguous."
  faqs={faqs}
  howToSteps={howToSteps}
  featureList={[
    'Converts between every zone in the IANA time zone database',
    'Handles half-hour and 45-minute offsets exactly',
    'Flags local times that do not exist or happen twice',
    'Shareable via the URL',
  ]}
>
  <Converter
    slot="tool"
    locale={locale}
    fromZone="America/New_York"
    toZone="Europe/London"
    seedInstant={BUILD_INSTANT}
    headingLevel="h2"
  />

  <section class="mt-12">
    <h2 class="text-[length:var(--text-2xl)]">Where the clocks change next</h2>
    <p class="prose mt-2 text-[var(--color-text-muted)]">
      Standard offsets and the next scheduled transition for eight widely-used zones. These dates
      come from the IANA database and are true until that database changes — they are not a live
      reading.
    </p>

    <div class="mt-4 overflow-x-auto">
      <table class="w-full min-w-[34rem] text-[length:var(--text-sm)]">
        <thead>
          <tr class="border-b border-[var(--color-rule)] text-left text-[var(--color-text-muted)]">
            <th scope="col" class="py-2 pr-4 font-medium">Zone</th>
            <th scope="col" class="py-2 pr-4 font-medium">Offset now</th>
            <th scope="col" class="py-2 font-medium">Next change</th>
          </tr>
        </thead>
        <tbody>
          {
            zoneFacts.map((fact) => (
              <tr class="border-b border-[var(--color-rule)]">
                <th scope="row" class="py-2 pr-4 text-left font-normal">
                  <a href={localePath(locale, '/time-in/')} class="no-underline hover:underline">
                    {fact.label}
                  </a>
                </th>
                <td class="tabular py-2 pr-4">{fact.offset}</td>
                <td class="py-2">
                  {fact.nextChange === null ? (
                    <span class="text-[var(--color-text-muted)]">{t('dst.doesNotObserve')}</span>
                  ) : (
                    <span>
                      <span class="tabular">{fact.nextChange.date}</span>{' '}
                      <span class="text-[var(--color-text-muted)]">
                        {fact.nextChange.direction === 'forward'
                          ? t('dst.clocksForward', { minutes: fact.nextChange.minutes })
                          : t('dst.clocksBack', { minutes: fact.nextChange.minutes })}
                      </span>
                    </span>
                  )}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="prose mt-12">
    <h2 class="text-[length:var(--text-2xl)]">What makes time zone conversion go wrong</h2>
    <p class="mt-3 text-[var(--color-text-muted)]">
      Almost every scheduling mistake comes from one of four places, and all four are handled here
      rather than rounded away.
    </p>
    <h3 class="mt-6 text-[length:var(--text-lg)]">The offset is not a constant</h3>
    <p class="mt-2 text-[var(--color-text-muted)]">
      "New York is five hours behind London" is true for about ten months of the year. For roughly
      three weeks each spring and one each autumn it is four hours, because the two regions change
      their clocks on different dates. A converter that stores a fixed offset per city is wrong on
      those days, and those are exactly the days people book the meeting they later regret.
    </p>
    <h3 class="mt-6 text-[length:var(--text-lg)]">Not every offset is a whole number of hours</h3>
    <p class="mt-2 text-[var(--color-text-muted)]">
      India is 5 hours 30 minutes ahead of UTC. Nepal is 5 hours 45 minutes ahead. The Chatham
      Islands are 12 hours 45 minutes ahead, and Lord Howe Island shifts by only 30 minutes when its
      daylight saving starts. Roughly a fifth of the world's population lives on a non-whole-hour
      offset.
    </p>
    <h3 class="mt-6 text-[length:var(--text-lg)]">Some local times do not exist</h3>
    <p class="mt-2 text-[var(--color-text-muted)]">
      When clocks spring forward, an hour is deleted. In New York on the changeover date, 01:59:59
      is followed immediately by 03:00:00 — so 02:30 never happens. Ask most tools to convert 02:30
      and they will answer confidently anyway. This one tells you what it did.
    </p>
    <h3 class="mt-6 text-[length:var(--text-lg)]">Some local times happen twice</h3>
    <p class="mt-2 text-[var(--color-text-muted)]">
      When clocks fall back, an hour repeats. 01:30 occurs once on daylight time and again an hour
      later on standard time. This converter takes the first occurrence and says so, and shows you
      the second.
    </p>
  </section>
</ToolPage>
