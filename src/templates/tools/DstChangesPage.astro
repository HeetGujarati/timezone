---
import ToolTemplate from '~/templates/ToolTemplate.astro';
import { CITIES } from '~/data/cities.ts';
import { countryName } from '~/lib/content/country.ts';
import { CURRENT_YEAR, NEXT_YEAR, BUILD_INSTANT } from '~/config/build.ts';
import { findDstTransitions } from '~/lib/time/dst.ts';
import { formatOffsetShort } from '~/lib/time/offset.ts';
import { hrefFor } from '~/lib/i18n/routes.ts';
import { useTranslations } from '~/lib/i18n/index.ts';
import type { LocaleCode } from '~/config/locales.ts';

type Props = { locale: LocaleCode };
const { locale } = Astro.props;

const t = useTranslations(locale);

/**
 * Every clock change in the covered cities for this year and next, computed at
 * build time from the IANA database. Nothing here is a live reading — these are
 * scheduled facts, which is exactly the kind of content a prerendered page should
 * carry.
 */
type ChangeRow = {
  citySlug: string;
  city: string;
  country: string;
  timeZone: string;
  isoDate: string;
  localTime: string;
  direction: 'forward' | 'backward';
  deltaMinutes: number;
  offsetBefore: string;
  offsetAfter: string;
  upcoming: boolean;
};

const rows: ChangeRow[] = [];
const seen = new Set<string>();

for (const city of CITIES) {
  for (const year of [CURRENT_YEAR, NEXT_YEAR]) {
    for (const transition of findDstTransitions(city.timeZone, year)) {
      // One row per city per transition; two cities sharing a zone both get a row,
      // because someone searching "Mumbai clocks change" wants to see Mumbai.
      const key = `${city.slug}|${transition.instant}`;
      if (seen.has(key)) continue;
      seen.add(key);

      rows.push({
        citySlug: city.slug,
        city: city.name,
        country: countryName(locale, city.countryCode, city.country),
        timeZone: city.timeZone,
        isoDate: `${transition.localAfter.year}-${String(transition.localAfter.month).padStart(2, '0')}-${String(transition.localAfter.day).padStart(2, '0')}`,
        localTime: `${String(transition.localBefore.hour).padStart(2, '0')}:${String(transition.localBefore.minute).padStart(2, '0')}`,
        direction: transition.direction,
        deltaMinutes: Math.abs(transition.deltaMinutes),
        offsetBefore: formatOffsetShort(transition.offsetBeforeMinutes),
        offsetAfter: formatOffsetShort(transition.offsetAfterMinutes),
        upcoming: transition.instant > BUILD_INSTANT,
      });
    }
  }
}

rows.sort((a, b) =>
  a.isoDate === b.isoDate ? a.city.localeCompare(b.city, 'en') : a.isoDate.localeCompare(b.isoDate),
);

const noDstCities = CITIES.filter(
  (city) =>
    findDstTransitions(city.timeZone, CURRENT_YEAR).length === 0 &&
    findDstTransitions(city.timeZone, NEXT_YEAR).length === 0,
);

const changingCount = new Set(rows.map((row) => row.citySlug)).size;
---

<ToolTemplate
  locale={locale}
  toolKey="dstChanges"
  path="/dst-changes/"
  keywords={[
    'dst changes',
    'daylight saving time dates',
    'when do clocks change',
    'clock change dates',
  ]}
  featureList={[
    'All scheduled changes for two years',
    'Exact local change time and offsets either side',
    'Cities that never change, listed separately',
  ]}
>
  <div
    slot="tool"
    class="rounded-[var(--radius-lg)] border border-[var(--color-rule)] bg-[var(--color-surface-raised)] p-4"
  >
    <label
      for="dst-filter"
      class="block text-[length:var(--text-sm)] font-medium text-[var(--color-text-muted)]"
    >
      {t('dst.filterCountry')}
    </label>
    <input
      id="dst-filter"
      data-role="filter"
      type="search"
      autocomplete="off"
      class="mt-1 w-full max-w-sm rounded-[var(--radius-md)] border border-[var(--color-rule)] bg-[var(--color-surface)] px-3 py-2"
    />
    <p class="mt-2 text-[length:var(--text-xs)] text-[var(--color-text-muted)]">
      {t('dst.tableNote', { count: rows.length, cities: changingCount })}
    </p>
  </div>

  <section class="mt-8">
    <div class="overflow-x-auto">
      <table data-role="dst-table" class="w-full min-w-[46rem] text-[length:var(--text-sm)]">
        <thead>
          <tr class="border-b border-[var(--color-rule)] text-left text-[var(--color-text-muted)]">
            <th scope="col" class="py-2 pr-4 font-medium">{t('table.date')}</th>
            <th scope="col" class="py-2 pr-4 font-medium">{t('table.city')}</th>
            <th scope="col" class="py-2 pr-4 font-medium">{t('table.country')}</th>
            <th scope="col" class="py-2 pr-4 font-medium">At</th>
            <th scope="col" class="py-2 pr-4 font-medium">{t('table.change')}</th>
            <th scope="col" class="py-2 font-medium">{t('table.offset')}</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((row) => (
              <tr
                data-search={`${row.city} ${row.country}`}
                class={`border-b border-[var(--color-rule)] ${row.upcoming ? '' : 'opacity-55'}`}
              >
                <td class="tabular py-2 pr-4 whitespace-nowrap">{row.isoDate}</td>
                <th scope="row" class="py-2 pr-4 text-left font-normal">
                  <a
                    href={hrefFor(locale, `/time-in/${row.citySlug}/`)}
                    class="no-underline hover:underline"
                  >
                    {row.city}
                  </a>
                </th>
                <td class="py-2 pr-4 text-[var(--color-text-muted)]">{row.country}</td>
                <td class="tabular py-2 pr-4">{row.localTime}</td>
                <td class="py-2 pr-4 whitespace-nowrap">
                  {row.direction === 'forward'
                    ? t('dst.clocksForward', { minutes: row.deltaMinutes })
                    : t('dst.clocksBack', { minutes: row.deltaMinutes })}
                </td>
                <td class="tabular py-2 whitespace-nowrap text-[var(--color-text-muted)]">
                  {row.offsetBefore} → {row.offsetAfter}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p data-role="empty" hidden class="mt-4 text-[var(--color-text-muted)]">
      {t('dst.noMatch')}
    </p>
  </section>

  <section class="mt-12">
    <h2 class="text-[length:var(--text-2xl)]">{t('dst.neverChange')}</h2>
    <p class="prose mt-2 text-[var(--color-text-muted)]">
      {t('dst.neverChangeNote', { count: noDstCities.length, total: CITIES.length })}
    </p>
    <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-[length:var(--text-sm)]">
      {
        noDstCities.map((city) => (
          <li>
            <a
              href={hrefFor(locale, `/time-in/${city.slug}/`)}
              class="no-underline hover:underline"
            >
              {city.name}
            </a>
            <span class="text-[var(--color-text-muted)]">
              · {countryName(locale, city.countryCode, city.country)}
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <script>
    import '~/islands/dst-filter.ts';
  </script>
</ToolTemplate>
