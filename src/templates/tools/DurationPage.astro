---
import ToolTemplate from '~/templates/ToolTemplate.astro';
import ZoneSelect from '~/components/ZoneSelect.astro';
import { useTranslations } from '~/lib/i18n/index.ts';
import type { LocaleCode } from '~/config/locales.ts';
import { BUILD_DATE_UTC } from '~/config/build.ts';

type Props = { locale: LocaleCode };
const { locale } = Astro.props;

const t = useTranslations(locale);
---

<ToolTemplate
  locale={locale}
  toolKey="durationCalculator"
  path="/duration-calculator/"
  keywords={[
    'duration calculator',
    'time between dates',
    'elapsed time calculator',
    'hours between two times',
  ]}
  featureList={[
    'Different zone at each end',
    'Daylight-saving-correct arithmetic',
    'Totals in days, hours, minutes and seconds',
  ]}
>
  <duration-calculator
    slot="tool"
    class="block rounded-[var(--radius-lg)] border border-[var(--color-rule)] bg-[var(--color-surface-raised)] p-4 md:p-6"
    data-locale={locale}
    data-label-before="The end is before the start — the figure below is how far apart they are."
  >
    <fieldset class="border-0 p-0">
      <legend class="text-[length:var(--text-sm)] font-semibold">{t('duration.start')}</legend>
      <div class="mt-2 grid gap-3 md:grid-cols-3">
        <div class="flex flex-col gap-1">
          <label
            for="duration-start-date"
            class="text-[length:var(--text-sm)] text-[var(--color-text-muted)]"
          >
            {t('common.date')}
          </label>
          <input
            id="duration-start-date"
            data-role="start-date"
            type="date"
            value={BUILD_DATE_UTC}
            class="rounded-[var(--radius-md)] border border-[var(--color-rule)] bg-[var(--color-surface)] px-3 py-2 font-[family-name:var(--font-mono)]"
          />
        </div>
        <div class="flex flex-col gap-1">
          <label
            for="duration-start-time"
            class="text-[length:var(--text-sm)] text-[var(--color-text-muted)]"
          >
            {t('common.time')}
          </label>
          <input
            id="duration-start-time"
            data-role="start-time"
            type="time"
            value="09:00"
            class="rounded-[var(--radius-md)] border border-[var(--color-rule)] bg-[var(--color-surface)] px-3 py-2 font-[family-name:var(--font-mono)]"
          />
        </div>
        <ZoneSelect id="duration-start-zone" name="start-zone" label="Zone" value="UTC" />
      </div>
    </fieldset>

    <fieldset class="mt-6 border-0 p-0">
      <legend class="text-[length:var(--text-sm)] font-semibold">{t('duration.end')}</legend>
      <div class="mt-2 grid gap-3 md:grid-cols-3">
        <div class="flex flex-col gap-1">
          <label
            for="duration-end-date"
            class="text-[length:var(--text-sm)] text-[var(--color-text-muted)]"
          >
            {t('common.date')}
          </label>
          <input
            id="duration-end-date"
            data-role="end-date"
            type="date"
            value={BUILD_DATE_UTC}
            class="rounded-[var(--radius-md)] border border-[var(--color-rule)] bg-[var(--color-surface)] px-3 py-2 font-[family-name:var(--font-mono)]"
          />
        </div>
        <div class="flex flex-col gap-1">
          <label
            for="duration-end-time"
            class="text-[length:var(--text-sm)] text-[var(--color-text-muted)]"
          >
            {t('common.time')}
          </label>
          <input
            id="duration-end-time"
            data-role="end-time"
            type="time"
            value="17:30"
            class="rounded-[var(--radius-md)] border border-[var(--color-rule)] bg-[var(--color-surface)] px-3 py-2 font-[family-name:var(--font-mono)]"
          />
        </div>
        <ZoneSelect id="duration-end-zone" name="end-zone" label="Zone" value="UTC" />
      </div>
    </fieldset>

    <p
      data-role="error"
      hidden
      role="alert"
      class="mt-3 text-[length:var(--text-sm)] text-[var(--color-signal)]"
    >
    </p>

    <div
      aria-live="polite"
      class="mt-6 rounded-[var(--radius-md)] bg-[var(--color-surface-sunken)] p-4"
    >
      <p
        class="text-[length:var(--text-xs)] tracking-wide text-[var(--color-text-muted)] uppercase"
      >
        {t('duration.result')}
      </p>
      <p data-out="headline" class="tabular mt-1 text-[length:var(--text-2xl)] font-semibold">—</p>
      <p data-out="direction" class="mt-2 text-[length:var(--text-sm)] text-[var(--color-signal)]">
      </p>
      <dl class="mt-4 grid grid-cols-2 gap-3 text-[length:var(--text-sm)] sm:grid-cols-4">
        <div>
          <dt class="text-[var(--color-text-muted)]">{t('duration.days')}</dt>
          <dd data-out="days" class="tabular font-semibold">—</dd>
        </div>
        <div>
          <dt class="text-[var(--color-text-muted)]">{t('duration.hours')}</dt>
          <dd data-out="hours" class="tabular font-semibold">—</dd>
        </div>
        <div>
          <dt class="text-[var(--color-text-muted)]">{t('duration.minutes')}</dt>
          <dd data-out="minutes" class="tabular font-semibold">—</dd>
        </div>
        <div>
          <dt class="text-[var(--color-text-muted)]">{t('duration.seconds')}</dt>
          <dd data-out="seconds" class="tabular font-semibold">—</dd>
        </div>
      </dl>
    </div>
  </duration-calculator>

  <script>
    import '~/islands/duration.ts';
  </script>
</ToolTemplate>
