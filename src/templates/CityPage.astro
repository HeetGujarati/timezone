---
import { countryName } from '~/lib/content/country.ts';
import { getMetaTemplates } from '~/content/meta/templates.ts';
import { getPageCopy } from '~/content/tools/index.ts';
import BaseLayout from '~/layouts/BaseLayout.astro';
import LiveClock from '~/components/LiveClock.astro';
import { useTranslations } from '~/lib/i18n/index.ts';
import { buildToolMetadata } from '~/lib/seo/metadata.ts';
import {
  breadcrumbListSchema,
  faqPageSchema,
  organizationSchema,
  softwareApplicationSchema,
} from '~/lib/seo/structured-data.ts';
import type { LocaleCode } from '~/config/locales.ts';
import { hrefFor } from '~/lib/i18n/routes.ts';
import { type City, TOP_HUBS } from '~/data/cities.ts';
import { pairsFromCity } from '~/data/pairs.ts';
import { BUILD_INSTANT, CURRENT_YEAR } from '~/config/build.ts';
import { formatOffsetShort, getOffsetMinutes, toZonedDateTime } from '~/lib/time/offset.ts';
import {
  findDstTransitions,
  getDaylightOffsetMinutes,
  getStandardOffsetMinutes,
} from '~/lib/time/dst.ts';
import { getSunTimes } from '~/lib/time/sun.ts';
import { formatDuration } from '~/lib/content/duration.ts';
import { describeDifferenceIn } from '~/lib/content/difference.ts';
import { zoneAbbreviation, zoneReading } from '~/lib/content/zone-reading.ts';
import { pickVariant } from '~/lib/seo/slug-hash.ts';

type Props = {
  city: City;
  locale: LocaleCode;
  availableLocales: readonly LocaleCode[];
};

const { city, locale, availableLocales } = Astro.props;
const t = useTranslations(locale);
const generated = getPageCopy(locale).generated;

const path = `/time-in/${city.slug}/`;

const transitions = findDstTransitions(city.timeZone, CURRENT_YEAR);

const meta = getMetaTemplates(locale);
const cityMetaInput = {
  city: city.name,
  country: countryName(locale, city.countryCode, city.country),
  hasTransitions: transitions.length > 0,
};
const title = meta.cityTitle(cityMetaInput);
const nextTransitions = [...transitions, ...findDstTransitions(city.timeZone, CURRENT_YEAR + 1)]
  .filter((transition) => transition.instant > BUILD_INSTANT)
  .slice(0, 2);

const standardOffset = getStandardOffsetMinutes(city.timeZone, CURRENT_YEAR);
const daylightOffset = getDaylightOffsetMinutes(city.timeZone, CURRENT_YEAR);
const currentOffset = getOffsetMinutes(city.timeZone, BUILD_INSTANT);
/** Null where the runtime has no letter abbreviation for this zone, only an offset. */
const letterAbbreviation = zoneAbbreviation(city.timeZone, BUILD_INSTANT);
const reading = zoneReading(locale, city.timeZone, BUILD_INSTANT);

const sun = getSunTimes(BUILD_INSTANT, city.timeZone, city.lat, city.lon);

function hhmm(instant: number): string {
  const zoned = toZonedDateTime(instant, city.timeZone);
  return `${String(zoned.hour).padStart(2, '0')}:${String(zoned.minute).padStart(2, '0')}`;
}

const hubDifferences = TOP_HUBS.filter((hub) => hub.slug !== city.slug).map((hub) => ({
  hub,
  label: describeDifferenceIn(
    locale,
    getOffsetMinutes(hub.timeZone, BUILD_INSTANT) - currentOffset,
  ),
}));

const outboundPairs = pairsFromCity(city, 12);

/**
 * Two opening sentences, chosen deterministically from the slug. The facts inside
 * them differ per city regardless; the variants stop 80 pages sharing a shape.
 * The shapes themselves live in the i18n dictionaries so that every locale gets
 * its own grammar rather than English word order with substituted nouns.
 */
const summaryClause =
  transitions.length === 0
    ? t('city.summary.clause.noDst')
    : t('city.summary.clause.dst', { count: transitions.length, year: CURRENT_YEAR });

const summary = t(
  pickVariant(['city.summary.1', 'city.summary.2'] as const, city.slug, 'citySummary'),
  {
    city: city.name,
    zone: city.timeZone,
    reading,
    clause: summaryClause,
  },
);

const metadata = buildToolMetadata({
  title,
  description: meta.cityDescription(cityMetaInput),
  keywords: [
    `time in ${city.name.toLowerCase()}`,
    `${city.name.toLowerCase()} time`,
    `current time ${city.name.toLowerCase()}`,
    ...city.aliases.map((alias) => `${alias.toLowerCase()} time`),
  ],
  path,
  locale,
  availableLocales,
  ogImage: `/og/time-in/${city.slug}.png`,
});

const faqs = [
  {
    question: t('city.faq.q.zone', { city: city.name }),
    answer: t('city.faq.a.zone', { city: city.name, zone: city.timeZone, reading }),
  },
  {
    question: t('city.faq.q.dst', { city: city.name }),
    answer:
      transitions.length === 0
        ? t('city.faq.a.dst.no', { city: city.name, standard: formatOffsetShort(standardOffset) })
        : t('city.faq.a.dst.yes', {
            city: city.name,
            standard: formatOffsetShort(standardOffset),
            daylight:
              daylightOffset === null
                ? formatOffsetShort(standardOffset)
                : formatOffsetShort(daylightOffset),
            count: transitions.length,
            year: CURRENT_YEAR,
          }),
  },
  {
    question: t('city.faq.q.utcDiff', { city: city.name }),
    answer:
      transitions.length === 0
        ? t('city.faq.a.utcDiff.fixed', { offset: formatOffsetShort(currentOffset) })
        : t('city.faq.a.utcDiff.varies', {
            offset: formatOffsetShort(currentOffset),
            standard: formatOffsetShort(standardOffset),
            daylight:
              daylightOffset === null
                ? formatOffsetShort(standardOffset)
                : formatOffsetShort(daylightOffset),
          }),
  },
  {
    question: t('city.faq.q.sun', { city: city.name }),
    answer: sun.polarDay
      ? t('city.faq.a.sun.polarDay', { city: city.name })
      : sun.polarNight
        ? t('city.faq.a.sun.polarNight', { city: city.name })
        : t('city.faq.a.sun.normal', {
            sunrise: sun.sunrise === null ? '—' : hhmm(sun.sunrise),
            sunset: sun.sunset === null ? '—' : hhmm(sun.sunset),
            daylight: formatDuration(locale, sun.daylightMinutes),
          }),
  },
];

const breadcrumbs = [
  { name: t('breadcrumb.home'), path: '/' },
  { name: t('nav.cities'), path: '/time-in/' },
  { name: city.name },
];

const schemas = [
  organizationSchema(),
  softwareApplicationSchema({
    name: title,
    description: metadata.description,
    path,
    locale,
    subCategory: 'World clock',
  }),
  breadcrumbListSchema(breadcrumbs, locale),
  faqPageSchema(faqs, locale),
];
---

<BaseLayout metadata={metadata} locale={locale} schemas={schemas} breadcrumbs={breadcrumbs}>
  <h1 class="text-[length:var(--text-3xl)]">{title}</h1>
  <p class="prose mt-3 text-[length:var(--text-lg)] text-[var(--color-text-muted)]">{summary}</p>

  <div
    class="mt-6 rounded-[var(--radius-lg)] border border-[var(--color-rule)] bg-[var(--color-surface-raised)] p-6"
  >
    <p class="text-[length:var(--text-xs)] tracking-wide text-[var(--color-text-muted)] uppercase">
      {city.name}, {countryName(locale, city.countryCode, city.country)}
    </p>
    <LiveClock
      locale={locale}
      timeZone={city.timeZone}
      showSeconds
      showDate
      size="xl"
      class="mt-2"
    />
  </div>

  <section class="mt-12">
    <h2 class="text-[length:var(--text-2xl)]">{generated.zoneFacts}</h2>
    <dl class="mt-4 grid gap-x-8 gap-y-3 text-[length:var(--text-sm)] sm:grid-cols-2">
      <div class="flex justify-between gap-3 border-b border-[var(--color-rule)] pb-2">
        <dt class="text-[var(--color-text-muted)]">{t('facts.ianaZone')}</dt>
        <dd class="tabular">{city.timeZone}</dd>
      </div>
      <div class="flex justify-between gap-3 border-b border-[var(--color-rule)] pb-2">
        <dt class="text-[var(--color-text-muted)]">{t('facts.abbreviation')}</dt>
        <dd class="tabular">{letterAbbreviation ?? '—'}</dd>
      </div>
      <div class="flex justify-between gap-3 border-b border-[var(--color-rule)] pb-2">
        <dt class="text-[var(--color-text-muted)]">{t('facts.standardOffset')}</dt>
        <dd class="tabular">{formatOffsetShort(standardOffset)}</dd>
      </div>
      <div class="flex justify-between gap-3 border-b border-[var(--color-rule)] pb-2">
        <dt class="text-[var(--color-text-muted)]">{t('facts.daylightOffset')}</dt>
        <dd class="tabular">{daylightOffset === null ? '—' : formatOffsetShort(daylightOffset)}</dd>
      </div>
      <div class="flex justify-between gap-3 border-b border-[var(--color-rule)] pb-2">
        <dt class="text-[var(--color-text-muted)]">{t('facts.country')}</dt>
        <dd>{countryName(locale, city.countryCode, city.country)} ({city.countryCode})</dd>
      </div>
      <div class="flex justify-between gap-3 border-b border-[var(--color-rule)] pb-2">
        <dt class="text-[var(--color-text-muted)]">{t('facts.coordinates')}</dt>
        <dd class="tabular">{city.lat.toFixed(2)}, {city.lon.toFixed(2)}</dd>
      </div>
    </dl>
  </section>

  <section class="mt-12">
    <h2 class="text-[length:var(--text-2xl)]">{generated.daylightSaving}</h2>
    {
      transitions.length === 0 ? (
        <p class="prose mt-2 text-[var(--color-text-muted)]">{generated.noDstNote}</p>
      ) : (
        <>
          <p class="prose mt-2 text-[var(--color-text-muted)]">
            {t('city.dstCount', {
              city: city.name,
              count: transitions.length,
              year: CURRENT_YEAR,
            })}
          </p>
          <ul class="mt-4 text-[length:var(--text-sm)]">
            {nextTransitions.map((transition) => (
              <li class="flex flex-wrap justify-between gap-3 border-b border-[var(--color-rule)] py-2">
                <span class="tabular">
                  {transition.localAfter.year}-
                  {String(transition.localAfter.month).padStart(2, '0')}-
                  {String(transition.localAfter.day).padStart(2, '0')} at{' '}
                  {String(transition.localBefore.hour).padStart(2, '0')}:
                  {String(transition.localBefore.minute).padStart(2, '0')}
                </span>
                <span class="text-[var(--color-text-muted)]">
                  {transition.direction === 'forward'
                    ? t('dst.clocksForward', { minutes: Math.abs(transition.deltaMinutes) })
                    : t('dst.clocksBack', { minutes: Math.abs(transition.deltaMinutes) })}{' '}
                  ({formatOffsetShort(transition.offsetBeforeMinutes)} →{' '}
                  {formatOffsetShort(transition.offsetAfterMinutes)})
                </span>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </section>

  <section class="mt-12">
    <h2 class="text-[length:var(--text-2xl)]">{generated.sunriseSunset}</h2>
    <p class="prose mt-2 text-[var(--color-text-muted)]">
      {generated.sunNote}
    </p>
    {
      sun.polarDay ? (
        <p class="mt-4 text-[var(--color-signal)]">{t('sun.polarDay', { city: city.name })}</p>
      ) : sun.polarNight ? (
        <p class="mt-4 text-[var(--color-signal)]">{t('sun.polarNight', { city: city.name })}</p>
      ) : (
        <dl class="mt-4 flex flex-wrap gap-8 text-[length:var(--text-sm)]">
          <div>
            <dt class="text-[var(--color-text-muted)]">{t('sun.sunrise')}</dt>
            <dd class="tabular text-[length:var(--text-xl)] font-semibold">
              {sun.sunrise === null ? '—' : hhmm(sun.sunrise)}
            </dd>
          </div>
          <div>
            <dt class="text-[var(--color-text-muted)]">{t('sun.sunset')}</dt>
            <dd class="tabular text-[length:var(--text-xl)] font-semibold">
              {sun.sunset === null ? '—' : hhmm(sun.sunset)}
            </dd>
          </div>
          <div>
            <dt class="text-[var(--color-text-muted)]">{t('sun.daylight')}</dt>
            <dd class="tabular text-[length:var(--text-xl)] font-semibold">
              {formatDuration(locale, sun.daylightMinutes)}
            </dd>
          </div>
        </dl>
      )
    }
  </section>

  <section class="mt-12">
    <h2 class="text-[length:var(--text-2xl)]">{generated.againstHubs}</h2>
    <div class="mt-4 overflow-x-auto">
      <table class="w-full min-w-[26rem] max-w-2xl text-[length:var(--text-sm)]">
        <thead>
          <tr class="border-b border-[var(--color-rule)] text-left text-[var(--color-text-muted)]">
            <th scope="col" class="py-2 pr-4 font-medium">{t('table.city')}</th>
            <th scope="col" class="py-2 font-medium"
              >{t('table.relativeTo', { city: city.name })}</th
            >
          </tr>
        </thead>
        <tbody>
          {
            hubDifferences.map((entry) => (
              <tr class="border-b border-[var(--color-rule)]">
                <th scope="row" class="py-2 pr-4 text-left font-normal">
                  <a
                    href={hrefFor(locale, `/time-in/${entry.hub.slug}/`)}
                    class="no-underline hover:underline"
                  >
                    {entry.hub.name}
                  </a>
                </th>
                <td class="py-2">{entry.label}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="mt-12">
    <h2 class="text-[length:var(--text-2xl)]">{t('faq.heading')}</h2>
    <dl class="prose mt-4 space-y-5">
      {
        faqs.map((faq) => (
          <div>
            <dt class="font-semibold">{faq.question}</dt>
            <dd class="mt-1 text-[var(--color-text-muted)]">{faq.answer}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <nav class="mt-12" aria-label={t('related.heading')}>
    <h2 class="text-[length:var(--text-2xl)]">{generated.convertTo}</h2>
    <ul class="mt-4 grid gap-2 text-[length:var(--text-sm)] sm:grid-cols-2 lg:grid-cols-3">
      {
        outboundPairs.map((pair) => (
          <li>
            <a
              href={hrefFor(locale, `/convert/${pair.slug}/`)}
              class="no-underline hover:underline"
            >
              {t('link.pairLabel', { from: pair.from.name, to: pair.to.name })}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</BaseLayout>
