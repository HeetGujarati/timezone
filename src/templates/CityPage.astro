---
import BaseLayout from '~/layouts/BaseLayout.astro';
import LiveClock from '~/components/LiveClock.astro';
import { useTranslations } from '~/lib/i18n/index.ts';
import { buildToolMetadata } from '~/lib/seo/metadata.ts';
import {
  breadcrumbListSchema,
  faqPageSchema,
  organizationSchema,
  softwareApplicationSchema,
} from '~/lib/seo/structured-data.ts';
import type { LocaleCode } from '~/config/locales.ts';
import { hrefFor } from '~/lib/i18n/routes.ts';
import { type City, TOP_HUBS } from '~/data/cities.ts';
import { pairsFromCity } from '~/data/pairs.ts';
import { BUILD_INSTANT, CURRENT_YEAR } from '~/config/build.ts';
import {
  formatOffsetShort,
  getOffsetMinutes,
  getZoneAbbreviation,
  toZonedDateTime,
} from '~/lib/time/offset.ts';
import {
  findDstTransitions,
  getDaylightOffsetMinutes,
  getStandardOffsetMinutes,
} from '~/lib/time/dst.ts';
import { getSunTimes, formatDaylight } from '~/lib/time/sun.ts';
import { describeDifference } from '~/lib/time/convert.ts';
import { pickVariant } from '~/lib/seo/slug-hash.ts';

type Props = {
  city: City;
  locale: LocaleCode;
  availableLocales: readonly LocaleCode[];
};

const { city, locale, availableLocales } = Astro.props;
const t = useTranslations(locale);

const path = `/time-in/${city.slug}/`;
const title = `Time in ${city.name}`;

const transitions = findDstTransitions(city.timeZone, CURRENT_YEAR);
const nextTransitions = [...transitions, ...findDstTransitions(city.timeZone, CURRENT_YEAR + 1)]
  .filter((transition) => transition.instant > BUILD_INSTANT)
  .slice(0, 2);

const standardOffset = getStandardOffsetMinutes(city.timeZone, CURRENT_YEAR);
const daylightOffset = getDaylightOffsetMinutes(city.timeZone, CURRENT_YEAR);
const currentOffset = getOffsetMinutes(city.timeZone, BUILD_INSTANT);
const abbreviation = getZoneAbbreviation(city.timeZone, BUILD_INSTANT);

const sun = getSunTimes(BUILD_INSTANT, city.timeZone, city.lat, city.lon);

function hhmm(instant: number): string {
  const zoned = toZonedDateTime(instant, city.timeZone);
  return `${String(zoned.hour).padStart(2, '0')}:${String(zoned.minute).padStart(2, '0')}`;
}

const hubDifferences = TOP_HUBS.filter((hub) => hub.slug !== city.slug).map((hub) => ({
  hub,
  label: describeDifference(getOffsetMinutes(hub.timeZone, BUILD_INSTANT) - currentOffset),
}));

const outboundPairs = pairsFromCity(city, 12);

/**
 * Four opening sentences, chosen deterministically from the slug. The facts inside
 * them differ per city regardless; the variants stop 80 pages sharing a shape.
 */
const summary = pickVariant(
  [
    `${city.name} runs on ${city.timeZone}, currently ${abbreviation} at ${formatOffsetShort(currentOffset)}. ${
      transitions.length === 0
        ? 'Its clocks never change, so that offset holds all year.'
        : `Its clocks change ${transitions.length} times in ${CURRENT_YEAR}.`
    }`,
    `The current offset in ${city.name} is ${formatOffsetShort(currentOffset)} (${abbreviation}), on the ${city.timeZone} zone. ${
      transitions.length === 0
        ? 'There is no daylight saving here — one offset, every day of the year.'
        : `Daylight saving moves it between ${formatOffsetShort(standardOffset)} and ${daylightOffset === null ? '' : formatOffsetShort(daylightOffset)}.`
    }`,
    `${city.name}, ${city.country}, keeps ${city.timeZone} time — ${abbreviation}, ${formatOffsetShort(currentOffset)} as of the last rebuild. ${
      transitions.length === 0
        ? 'No seasonal changes.'
        : `${transitions.length} clock changes this year.`
    }`,
    `Clocks in ${city.name} read ${formatOffsetShort(currentOffset)} from UTC right now, under the ${city.timeZone} identifier. ${
      transitions.length === 0
        ? 'That does not change through the year.'
        : 'The exact change dates are below.'
    }`,
  ],
  city.slug,
  'citySummary',
);

const metadata = buildToolMetadata({
  title,
  description: `Current local time in ${city.name}, ${city.country} — live clock, UTC offset, daylight saving dates${transitions.length === 0 ? '' : ' for this year and next'}, sunrise and sunset, and conversions to major cities.`,
  keywords: [
    `time in ${city.name.toLowerCase()}`,
    `${city.name.toLowerCase()} time`,
    `current time ${city.name.toLowerCase()}`,
    ...city.aliases.map((alias) => `${alias.toLowerCase()} time`),
  ],
  path,
  locale,
  availableLocales,
  ogImage: `/og/time-in/${city.slug}.png`,
});

const faqs = [
  {
    question: `What time zone is ${city.name} in?`,
    answer: `${city.name} uses the ${city.timeZone} time zone, currently abbreviated ${abbreviation} at ${formatOffsetShort(currentOffset)}. Use the IANA identifier rather than the abbreviation in any code — abbreviations are ambiguous, and this one may mean something different somewhere else.`,
  },
  {
    question: `Does ${city.name} observe daylight saving time?`,
    answer:
      transitions.length === 0
        ? `No. ${city.name} keeps ${formatOffsetShort(standardOffset)} all year round, so its offset from UTC never changes.`
        : `Yes. ${city.name} moves between ${formatOffsetShort(standardOffset)} in winter and ${daylightOffset === null ? '' : formatOffsetShort(daylightOffset)} in summer, changing ${transitions.length} times in ${CURRENT_YEAR}.`,
  },
  {
    question: `What is the difference between ${city.name} and UTC?`,
    answer: `${formatOffsetShort(currentOffset)} as of the last rebuild.${
      transitions.length === 0
        ? ' That figure is constant, because the city does not change its clocks.'
        : ` It swings between ${formatOffsetShort(standardOffset)} and ${daylightOffset === null ? '' : formatOffsetShort(daylightOffset)} across the year.`
    }`,
  },
  {
    question: `When does the sun rise and set in ${city.name}?`,
    answer: sun.polarDay
      ? `At this time of year the sun does not set in ${city.name} — it stays above the horizon for the full 24 hours.`
      : sun.polarNight
        ? `At this time of year the sun does not rise in ${city.name} — it stays below the horizon all day.`
        : `On the day of the last rebuild, sunrise was ${sun.sunrise === null ? '' : hhmm(sun.sunrise)} and sunset ${sun.sunset === null ? '' : hhmm(sun.sunset)} local time, giving ${formatDaylight(sun.daylightMinutes)} of daylight. These are computed from the city's latitude and longitude, not fetched from anywhere.`,
  },
];

const breadcrumbs = [
  { name: t('breadcrumb.home'), path: '/' },
  { name: t('nav.cities'), path: '/time-in/' },
  { name: city.name },
];

const schemas = [
  organizationSchema(),
  softwareApplicationSchema({
    name: title,
    description: metadata.description,
    path,
    locale,
    subCategory: 'World clock',
  }),
  breadcrumbListSchema(breadcrumbs, locale),
  faqPageSchema(faqs, locale),
];
---

<BaseLayout metadata={metadata} locale={locale} schemas={schemas} breadcrumbs={breadcrumbs}>
  <h1 class="text-[length:var(--text-3xl)]">{title}</h1>
  <p class="prose mt-3 text-[length:var(--text-lg)] text-[var(--color-text-muted)]">{summary}</p>

  <div
    class="mt-6 rounded-[var(--radius-lg)] border border-[var(--color-rule)] bg-[var(--color-surface-raised)] p-6"
  >
    <p class="text-[length:var(--text-xs)] tracking-wide text-[var(--color-text-muted)] uppercase">
      {city.name}, {city.country}
    </p>
    <LiveClock
      locale={locale}
      timeZone={city.timeZone}
      showSeconds
      showDate
      size="xl"
      class="mt-2"
    />
  </div>

  <section class="mt-12">
    <h2 class="text-[length:var(--text-2xl)]">Zone facts</h2>
    <dl class="mt-4 grid gap-x-8 gap-y-3 text-[length:var(--text-sm)] sm:grid-cols-2">
      <div class="flex justify-between gap-3 border-b border-[var(--color-rule)] pb-2">
        <dt class="text-[var(--color-text-muted)]">IANA identifier</dt>
        <dd class="tabular">{city.timeZone}</dd>
      </div>
      <div class="flex justify-between gap-3 border-b border-[var(--color-rule)] pb-2">
        <dt class="text-[var(--color-text-muted)]">Abbreviation</dt>
        <dd class="tabular">{abbreviation}</dd>
      </div>
      <div class="flex justify-between gap-3 border-b border-[var(--color-rule)] pb-2">
        <dt class="text-[var(--color-text-muted)]">Standard offset</dt>
        <dd class="tabular">{formatOffsetShort(standardOffset)}</dd>
      </div>
      <div class="flex justify-between gap-3 border-b border-[var(--color-rule)] pb-2">
        <dt class="text-[var(--color-text-muted)]">Daylight offset</dt>
        <dd class="tabular">{daylightOffset === null ? '—' : formatOffsetShort(daylightOffset)}</dd>
      </div>
      <div class="flex justify-between gap-3 border-b border-[var(--color-rule)] pb-2">
        <dt class="text-[var(--color-text-muted)]">Country</dt>
        <dd>{city.country} ({city.countryCode})</dd>
      </div>
      <div class="flex justify-between gap-3 border-b border-[var(--color-rule)] pb-2">
        <dt class="text-[var(--color-text-muted)]">Coordinates</dt>
        <dd class="tabular">{city.lat.toFixed(2)}, {city.lon.toFixed(2)}</dd>
      </div>
    </dl>
  </section>

  <section class="mt-12">
    <h2 class="text-[length:var(--text-2xl)]">Daylight saving</h2>
    {
      transitions.length === 0 ? (
        <p class="prose mt-2 text-[var(--color-text-muted)]">
          {city.name} does not observe daylight saving time. Its offset from UTC is the same on
          every day of the year, which makes it one of the easier cities to schedule against.
        </p>
      ) : (
        <>
          <p class="prose mt-2 text-[var(--color-text-muted)]">
            Clocks in {city.name} change {transitions.length} times in {CURRENT_YEAR}. The next
            changes:
          </p>
          <ul class="mt-4 text-[length:var(--text-sm)]">
            {nextTransitions.map((transition) => (
              <li class="flex flex-wrap justify-between gap-3 border-b border-[var(--color-rule)] py-2">
                <span class="tabular">
                  {transition.localAfter.year}-
                  {String(transition.localAfter.month).padStart(2, '0')}-
                  {String(transition.localAfter.day).padStart(2, '0')} at{' '}
                  {String(transition.localBefore.hour).padStart(2, '0')}:
                  {String(transition.localBefore.minute).padStart(2, '0')}
                </span>
                <span class="text-[var(--color-text-muted)]">
                  {transition.direction === 'forward'
                    ? t('dst.clocksForward', { minutes: Math.abs(transition.deltaMinutes) })
                    : t('dst.clocksBack', { minutes: Math.abs(transition.deltaMinutes) })}{' '}
                  ({formatOffsetShort(transition.offsetBeforeMinutes)} →{' '}
                  {formatOffsetShort(transition.offsetAfterMinutes)})
                </span>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </section>

  <section class="mt-12">
    <h2 class="text-[length:var(--text-2xl)]">Sunrise and sunset</h2>
    <p class="prose mt-2 text-[var(--color-text-muted)]">
      Computed from {city.name}'s latitude and longitude with the NOAA solar position algorithm — no
      API, no network call. For the day of the last rebuild.
    </p>
    {
      sun.polarDay ? (
        <p class="mt-4 text-[var(--color-signal)]">
          The sun does not set on this date: {city.name} is inside the polar day.
        </p>
      ) : sun.polarNight ? (
        <p class="mt-4 text-[var(--color-signal)]">
          The sun does not rise on this date: {city.name} is inside the polar night.
        </p>
      ) : (
        <dl class="mt-4 flex flex-wrap gap-8 text-[length:var(--text-sm)]">
          <div>
            <dt class="text-[var(--color-text-muted)]">Sunrise</dt>
            <dd class="tabular text-[length:var(--text-xl)] font-semibold">
              {sun.sunrise === null ? '—' : hhmm(sun.sunrise)}
            </dd>
          </div>
          <div>
            <dt class="text-[var(--color-text-muted)]">Sunset</dt>
            <dd class="tabular text-[length:var(--text-xl)] font-semibold">
              {sun.sunset === null ? '—' : hhmm(sun.sunset)}
            </dd>
          </div>
          <div>
            <dt class="text-[var(--color-text-muted)]">Daylight</dt>
            <dd class="tabular text-[length:var(--text-xl)] font-semibold">
              {formatDaylight(sun.daylightMinutes)}
            </dd>
          </div>
        </dl>
      )
    }
  </section>

  <section class="mt-12">
    <h2 class="text-[length:var(--text-2xl)]">{city.name} against the major hubs</h2>
    <div class="mt-4 overflow-x-auto">
      <table class="w-full min-w-[26rem] max-w-2xl text-[length:var(--text-sm)]">
        <thead>
          <tr class="border-b border-[var(--color-rule)] text-left text-[var(--color-text-muted)]">
            <th scope="col" class="py-2 pr-4 font-medium">City</th>
            <th scope="col" class="py-2 font-medium">Relative to {city.name}</th>
          </tr>
        </thead>
        <tbody>
          {
            hubDifferences.map((entry) => (
              <tr class="border-b border-[var(--color-rule)]">
                <th scope="row" class="py-2 pr-4 text-left font-normal">
                  <a
                    href={hrefFor(locale, `/time-in/${entry.hub.slug}/`)}
                    class="no-underline hover:underline"
                  >
                    {entry.hub.name}
                  </a>
                </th>
                <td class="py-2">{entry.label}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="mt-12">
    <h2 class="text-[length:var(--text-2xl)]">{t('faq.heading')}</h2>
    <dl class="prose mt-4 space-y-5">
      {
        faqs.map((faq) => (
          <div>
            <dt class="font-semibold">{faq.question}</dt>
            <dd class="mt-1 text-[var(--color-text-muted)]">{faq.answer}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <nav class="mt-12" aria-label={t('related.heading')}>
    <h2 class="text-[length:var(--text-2xl)]">Convert {city.name} to</h2>
    <ul class="mt-4 grid gap-2 text-[length:var(--text-sm)] sm:grid-cols-2 lg:grid-cols-3">
      {
        outboundPairs.map((pair) => (
          <li>
            <a
              href={hrefFor(locale, `/convert/${pair.slug}/`)}
              class="no-underline hover:underline"
            >
              {pair.from.name} to {pair.to.name}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</BaseLayout>
