---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Converter from '~/components/Converter.astro';
import { useTranslations } from '~/lib/i18n/index.ts';
import { buildToolMetadata } from '~/lib/seo/metadata.ts';
import {
  breadcrumbListSchema,
  faqPageSchema,
  organizationSchema,
  softwareApplicationSchema,
} from '~/lib/seo/structured-data.ts';
import type { LocaleCode } from '~/config/locales.ts';
import { hrefFor } from '~/lib/i18n/routes.ts';
import { formatDuration } from '~/lib/content/duration.ts';
import { getMetaTemplates } from '~/content/meta/templates.ts';
import { buildPairFacts } from '~/lib/content/pair-facts.ts';
import {
  callWindowSentence,
  dstIntro,
  factsIntro,
  pairFaqs,
  summarySentence,
  tableIntro,
} from '~/lib/content/pair-copy.ts';
import { relatedPairs, reversePair, type CityPair } from '~/data/pairs.ts';
import { getPageCopy } from '~/content/tools/index.ts';
import { countryName } from '~/lib/content/country.ts';
import { BUILD_INSTANT } from '~/config/build.ts';

type Props = {
  pair: CityPair;
  locale: LocaleCode;
  availableLocales: readonly LocaleCode[];
};

const { pair, locale, availableLocales } = Astro.props;
const { from, to, slug } = pair;
const t = useTranslations(locale);

const facts = buildPairFacts(from, to, BUILD_INSTANT);
const copyInput = { from, to, slug, facts, locale };

const path = `/convert/${slug}/`;

const generated = getPageCopy(locale).generated;
const meta = getMetaTemplates(locale);
const metaInput = {
  from: from.name,
  to: to.name,
  difference: formatDuration(locale, facts.differenceMinutes),
  targetAhead: facts.targetAhead,
  sameZone: facts.sameZone,
  sameTime: facts.sameTime,
};
const title = meta.pairTitle(metaInput);

const metadata = buildToolMetadata({
  title,
  description: meta.pairDescription(metaInput),
  keywords: [
    `${from.name.toLowerCase()} to ${to.name.toLowerCase()}`,
    `${from.name.toLowerCase()} ${to.name.toLowerCase()} time difference`,
    `time in ${to.name.toLowerCase()}`,
  ],
  path,
  locale,
  availableLocales,
  ogImage: `/og/convert/${slug}.png`,
});

const faqs = pairFaqs(copyInput);
const reverse = reversePair(pair);
const related = relatedPairs(pair, 6);

const breadcrumbs = [
  { name: t('breadcrumb.home'), path: '/' },
  { name: t('nav.conversions'), path: '/convert/' },
  { name: `${from.name} → ${to.name}` },
];

const schemas = [
  organizationSchema(),
  softwareApplicationSchema({
    name: title,
    description: metadata.description,
    path,
    locale,
    subCategory: 'Time zone converter',
  }),
  breadcrumbListSchema(breadcrumbs, locale),
  faqPageSchema(faqs, locale),
];

function pad(value: number): string {
  return String(value).padStart(2, '0');
}
---

<BaseLayout metadata={metadata} locale={locale} schemas={schemas} breadcrumbs={breadcrumbs}>
  <h1 class="text-[length:var(--text-3xl)]">{title}</h1>
  <p class="prose mt-3 text-[length:var(--text-lg)] text-[var(--color-text-muted)]">
    {summarySentence(copyInput)}
  </p>

  <div class="mt-6">
    <Converter
      locale={locale}
      fromZone={from.timeZone}
      toZone={to.timeZone}
      seedInstant={BUILD_INSTANT}
      headingLevel="h2"
    />
  </div>

  <section class="mt-12">
    <h2 class="text-[length:var(--text-2xl)]">{generated.hourByHour}</h2>
    <p class="prose mt-2 text-[var(--color-text-muted)]">{tableIntro(copyInput)}</p>
    <div class="mt-4 overflow-x-auto">
      <table class="w-full min-w-[22rem] max-w-lg text-[length:var(--text-sm)]">
        <thead>
          <tr class="border-b border-[var(--color-rule)] text-left text-[var(--color-text-muted)]">
            <th scope="col" class="py-2 pr-4 font-medium">{from.name}</th>
            <th scope="col" class="py-2 font-medium">{to.name}</th>
          </tr>
        </thead>
        <tbody>
          {
            facts.hourTable.map((row) => (
              <tr class="border-b border-[var(--color-rule)]">
                <td class="tabular py-1.5 pr-4">
                  {pad(row.fromHour)}:{pad(row.fromMinute)}
                </td>
                <td class="tabular py-1.5">
                  {pad(row.toHour)}:{pad(row.toMinute)}
                  {row.dayDelta !== 0 && (
                    <span class="ms-2 text-[length:var(--text-xs)] text-[var(--color-signal)]">
                      {row.dayDelta > 0 ? t('table.nextDay') : t('table.previousDay')}
                    </span>
                  )}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="mt-12">
    <h2 class="text-[length:var(--text-2xl)]">{generated.daylightSaving}</h2>
    <p class="prose mt-2 text-[var(--color-text-muted)]">{dstIntro(copyInput)}</p>

    <div class="mt-4 grid gap-4 md:grid-cols-2">
      {
        [
          { city: from, zone: facts.from },
          { city: to, zone: facts.to },
        ].map((entry) => (
          <div class="rounded-[var(--radius-md)] border border-[var(--color-rule)] p-4">
            <h3 class="text-[length:var(--text-lg)]">{entry.city.name}</h3>
            <p class="mt-1 text-[length:var(--text-sm)] text-[var(--color-text-muted)]">
              {entry.zone.observesDst ? t('dst.observes') : t('dst.doesNotObserve')}
            </p>
            <dl class="mt-3 space-y-1 text-[length:var(--text-sm)]">
              <div class="flex justify-between gap-3">
                <dt class="text-[var(--color-text-muted)]">{t('facts.standard')}</dt>
                <dd class="tabular">{entry.zone.standardOffsetLabel}</dd>
              </div>
              {entry.zone.daylightOffsetLabel !== null && (
                <div class="flex justify-between gap-3">
                  <dt class="text-[var(--color-text-muted)]">{t('facts.daylight')}</dt>
                  <dd class="tabular">{entry.zone.daylightOffsetLabel}</dd>
                </div>
              )}
              {entry.zone.nextChange !== null && (
                <div class="flex justify-between gap-3">
                  <dt class="text-[var(--color-text-muted)]">{t('dst.nextChange')}</dt>
                  <dd class="tabular">
                    {entry.zone.nextChange.isoDate}{' '}
                    <span class="text-[var(--color-text-muted)]">
                      {entry.zone.nextChange.direction === 'forward' ? '+' : '−'}
                      {entry.zone.nextChange.deltaMinutes}m
                    </span>
                  </dd>
                </div>
              )}
            </dl>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mt-12">
    <h2 class="text-[length:var(--text-2xl)]">{generated.whenYouCanTalk}</h2>
    <p class="prose mt-2 text-[var(--color-text-muted)]">{callWindowSentence(copyInput)}</p>

    {
      facts.callWindows.length > 0 && (
        <ul class="mt-4 space-y-2 text-[length:var(--text-sm)]">
          {facts.callWindows.map((window) => (
            <li class="flex flex-wrap justify-between gap-3 border-b border-[var(--color-rule)] py-2">
              <span class="tabular">
                {from.name} {window.fromRange}
              </span>
              <span class="tabular text-[var(--color-text-muted)]">
                {to.name} {window.toRange}
              </span>
            </li>
          ))}
        </ul>
      )
    }

    {
      facts.nearestWorkable.length > 0 && (
        <ul class="mt-4 space-y-2 text-[length:var(--text-sm)]">
          {facts.nearestWorkable.map((window) => (
            <li class="flex flex-wrap justify-between gap-3 border-b border-[var(--color-rule)] py-2">
              <span class="tabular">
                {from.name} {window.fromRange}
              </span>
              <span class="tabular text-[var(--color-text-muted)]">
                {to.name} {window.toRange}
              </span>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <section class="mt-12">
    <h2 class="text-[length:var(--text-2xl)]">{generated.reference}</h2>
    <p class="prose mt-2 text-[var(--color-text-muted)]">{factsIntro(copyInput)}</p>
    <div class="mt-4 overflow-x-auto">
      <table class="w-full min-w-[30rem] text-[length:var(--text-sm)]">
        <thead>
          <tr class="border-b border-[var(--color-rule)] text-left text-[var(--color-text-muted)]">
            <th scope="col" class="py-2 pr-4 font-medium">&nbsp;</th>
            <th scope="col" class="py-2 pr-4 font-medium">{from.name}</th>
            <th scope="col" class="py-2 font-medium">{to.name}</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-[var(--color-rule)]">
            <th scope="row" class="py-2 pr-4 text-left font-normal text-[var(--color-text-muted)]"
              >{t('facts.ianaZone')}</th
            >
            <td class="tabular py-2 pr-4">{facts.from.timeZone}</td>
            <td class="tabular py-2">{facts.to.timeZone}</td>
          </tr>
          <tr class="border-b border-[var(--color-rule)]">
            <th scope="row" class="py-2 pr-4 text-left font-normal text-[var(--color-text-muted)]"
              >{t('facts.abbreviation')}</th
            >
            <td class="tabular py-2 pr-4">{facts.from.abbreviation}</td>
            <td class="tabular py-2">{facts.to.abbreviation}</td>
          </tr>
          <tr class="border-b border-[var(--color-rule)]">
            <th scope="row" class="py-2 pr-4 text-left font-normal text-[var(--color-text-muted)]"
              >{t('facts.standardOffset')}</th
            >
            <td class="tabular py-2 pr-4">{facts.from.standardOffsetLabel}</td>
            <td class="tabular py-2">{facts.to.standardOffsetLabel}</td>
          </tr>
          <tr class="border-b border-[var(--color-rule)]">
            <th scope="row" class="py-2 pr-4 text-left font-normal text-[var(--color-text-muted)]"
              >{t('facts.daylightOffset')}</th
            >
            <td class="tabular py-2 pr-4">{facts.from.daylightOffsetLabel ?? '—'}</td>
            <td class="tabular py-2">{facts.to.daylightOffsetLabel ?? '—'}</td>
          </tr>
          <tr class="border-b border-[var(--color-rule)]">
            <th scope="row" class="py-2 pr-4 text-left font-normal text-[var(--color-text-muted)]"
              >{t('facts.clockChangesThisYear')}</th
            >
            <td class="tabular py-2 pr-4">{facts.from.changesThisYear}</td>
            <td class="tabular py-2">{facts.to.changesThisYear}</td>
          </tr>
          <tr class="border-b border-[var(--color-rule)]">
            <th scope="row" class="py-2 pr-4 text-left font-normal text-[var(--color-text-muted)]"
              >{t('facts.country')}</th
            >
            <td class="py-2 pr-4">{countryName(locale, from.countryCode, from.country)}</td>
            <td class="py-2">{countryName(locale, to.countryCode, to.country)}</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-[length:var(--text-xs)] text-[var(--color-text-muted)]">
      {t('note.exampleTimestamp')}
    </p>
  </section>

  <section class="mt-12">
    <h2 class="text-[length:var(--text-2xl)]">{t('faq.heading')}</h2>
    <dl class="prose mt-4 space-y-5">
      {
        faqs.map((faq) => (
          <div>
            <dt class="font-semibold">{faq.question}</dt>
            <dd class="mt-1 text-[var(--color-text-muted)]">{faq.answer}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <nav class="mt-12" aria-label={t('related.heading')}>
    <h2 class="text-[length:var(--text-2xl)]">{t('related.heading')}</h2>
    <ul class="mt-4 grid gap-2 text-[length:var(--text-sm)] sm:grid-cols-2">
      {
        reverse !== undefined && (
          <li>
            <a
              href={hrefFor(locale, `/convert/${reverse.slug}/`)}
              class="no-underline hover:underline"
            >
              {t('link.pairLabel', { from: to.name, to: from.name })}
            </a>
          </li>
        )
      }
      {
        related.map((candidate) => (
          <li>
            <a
              href={hrefFor(locale, `/convert/${candidate.slug}/`)}
              class="no-underline hover:underline"
            >
              {t('link.pairLabel', { from: candidate.from.name, to: candidate.to.name })}
            </a>
          </li>
        ))
      }
      <li>
        <a href={hrefFor(locale, `/time-in/${from.slug}/`)} class="no-underline hover:underline">
          {t('link.currentTimeIn', { city: from.name })}
        </a>
      </li>
      <li>
        <a href={hrefFor(locale, `/time-in/${to.slug}/`)} class="no-underline hover:underline">
          {t('link.currentTimeIn', { city: to.name })}
        </a>
      </li>
      <li>
        <a href={hrefFor(locale, '/meeting-planner/')} class="no-underline hover:underline">
          {t('nav.meetingPlanner')}
        </a>
      </li>
    </ul>
  </nav>
</BaseLayout>
