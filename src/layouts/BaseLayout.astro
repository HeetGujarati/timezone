---
import '~/styles/global.css';
import SeoHead from '~/components/SeoHead.astro';
import ConsentBanner from '~/components/ConsentBanner.astro';
import Analytics from '~/components/Analytics.astro';
import SiteHeader from '~/components/SiteHeader.astro';
import SiteFooter from '~/components/SiteFooter.astro';
import ThemeScript from '~/components/ThemeScript.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import { documentAttributes } from '~/lib/seo/metadata.ts';
import { useTranslations } from '~/lib/i18n/index.ts';
import type { ResolvedMetadata } from '~/lib/seo/types.ts';
import type { BreadcrumbItem } from '~/lib/seo/structured-data.ts';
import type { LocaleCode } from '~/config/locales.ts';

type Props = {
  metadata: ResolvedMetadata;
  locale: LocaleCode;
  schemas?: Record<string, unknown>[];
  breadcrumbs?: readonly BreadcrumbItem[];
};

const { metadata, locale, schemas = [], breadcrumbs = [] } = Astro.props;
const { lang, dir } = documentAttributes(locale);
const t = useTranslations(locale);
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {
      /*
      A browser asks for /favicon.ico whether or not a page declares an icon, so
      the file exists as well as the link: without it every visit logs a 404 in
      the reader's console, which is both noise and a Lighthouse finding. The SVG
      is listed first and wins wherever it is understood.
    */
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f5f6f8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111721" media="(prefers-color-scheme: dark)" />

    <ThemeScript />
    <SeoHead metadata={metadata} schemas={schemas} />
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3451224240753943" crossorigin="anonymous"></script>
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="skip-link">{t('site.skipToContent')}</a>
    <SiteHeader locale={locale} />

    <main id="main" class="shell flex-1 py-8" tabindex="-1">
      {
        breadcrumbs.length > 0 && (
          <div class="mb-6">
            <Breadcrumbs items={breadcrumbs} locale={locale} label={t('breadcrumb.label')} />
          </div>
        )
      }
      <slot />
    </main>

    <SiteFooter locale={locale} alternates={metadata.alternates} />
    <ConsentBanner locale={locale} />
    <Analytics />
  </body>
</html>
