---
import '~/styles/global.css';
import SeoHead from '~/components/SeoHead.astro';
import { documentAttributes } from '~/lib/seo/metadata.ts';
import type { ResolvedMetadata } from '~/lib/seo/types.ts';
import type { LocaleCode } from '~/config/locales.ts';

type Props = {
  metadata: ResolvedMetadata;
  locale: LocaleCode;
  schemas?: Record<string, unknown>[];
};

const { metadata, locale, schemas = [] } = Astro.props;
const { lang, dir } = documentAttributes(locale);
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead metadata={metadata} schemas={schemas} />
  </head>
  <body>
    <slot />
  </body>
</html>
