---
/**
 * Rendered hidden and revealed by the island once it upgrades, so a reader with
 * JavaScript off is never offered a control that cannot work.
 */
---

<theme-toggle>
  <button
    type="button"
    hidden
    class="grid h-9 w-9 place-items-center rounded-[var(--radius-md)] border border-[var(--color-rule)] bg-[var(--color-surface-raised)] text-[var(--color-text-muted)] hover:text-[var(--color-text)]"
    aria-label="Switch theme"
    aria-pressed="false"
  >
    <svg
      aria-hidden="true"
      viewBox="0 0 20 20"
      class="h-4 w-4"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
    >
      <path
        d="M10 2.5v2M10 15.5v2M4.7 4.7l1.4 1.4M13.9 13.9l1.4 1.4M2.5 10h2M15.5 10h2M4.7 15.3l1.4-1.4M13.9 6.1l1.4-1.4"
        stroke-linecap="round"></path>
      <circle cx="10" cy="10" r="3.25"></circle>
    </svg>
  </button>
</theme-toggle>

<script>
  import '~/islands/theme-toggle.ts';
</script>
