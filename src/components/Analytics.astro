---
import { CF_ANALYTICS_TOKEN, GA_ID } from '~/config/flags.ts';

/**
 * Analytics tags injection.
 *
 * Both Cloudflare Web Analytics and Google Analytics can be enabled via environment variables.
 *
 * - Cloudflare's beacon: Sets no cookie, stores no identifier.
 * - Google Analytics: Sets cookies and requires a consent banner (`PUBLIC_ADS_ENABLED=true`).
 *   The GA script defaults `analytics_storage` to 'denied' until the user accepts the banner.
 */
const beacon = CF_ANALYTICS_TOKEN === '' ? null : JSON.stringify({ token: CF_ANALYTICS_TOKEN });
---

{
  beacon !== null && (
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={beacon}
    />
  )
}

{
  GA_ID !== '' && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
      <script is:inline set:html={`
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('consent', 'default', {
          'analytics_storage': 'denied'
        });
        gtag('js', new Date());
        gtag('config', '${GA_ID}');
      `} />
    </>
  )
}
