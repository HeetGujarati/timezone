---
import ThemeToggle from './ThemeToggle.astro';
import type { LocaleCode } from '~/config/locales.ts';
import { hrefFor } from '~/lib/i18n/routes.ts';
import { useTranslations } from '~/lib/i18n/index.ts';
import { SITE } from '~/config/site.ts';

type Props = { locale: LocaleCode };

const { locale } = Astro.props;
const t = useTranslations(locale);

const primaryLinks = [
  { href: '/meeting-planner/', label: t('nav.meetingPlanner') },
  { href: '/world-clock/', label: t('nav.worldClock') },
  { href: '/time-difference/', label: t('nav.timeDifference') },
  { href: '/dst-changes/', label: t('nav.dstChanges') },
  { href: '/guides/', label: t('nav.guides') },
];

const currentPath = Astro.url.pathname;
---

<header class="border-b border-[var(--color-rule)] bg-[var(--color-surface-raised)]">
  <div class="shell flex h-14 items-center justify-between gap-4">
    <a
      href={hrefFor(locale, '/')}
      class="site-logo font-[family-name:var(--font-display)] text-[length:var(--text-lg)] tracking-tight text-[var(--color-text)] no-underline"
    >
      <svg class="site-logo__icon" width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.6"/>
        <ellipse cx="12" cy="12" rx="4.5" ry="10" stroke="currentColor" stroke-width="1.4"/>
        <path d="M2.5 9h19M2.5 15h19" stroke="currentColor" stroke-width="1.2" opacity="0.5"/>
        <circle cx="12" cy="12" r="1.8" fill="url(#logo-grad)"/>
        <defs>
          <linearGradient id="logo-grad" x1="10" y1="10" x2="14" y2="14">
            <stop offset="0%" stop-color="#3b82f6"/>
            <stop offset="100%" stop-color="#06b6d4"/>
          </linearGradient>
        </defs>
      </svg>
      <span class="site-logo__text">
        <span class="site-logo__your">Your</span><span class="site-logo__world">World</span><span class="site-logo__time">Time</span>
      </span>
    </a>

    <nav aria-label={t('nav.label')} class="hidden md:block">
      <ul class="flex items-center gap-5 text-[length:var(--text-sm)]">
        {
          primaryLinks.map((link) => {
            const href = hrefFor(locale, link.href);
            const isCurrent = currentPath === href;
            return (
              <li>
                <a
                  href={href}
                  class="text-[var(--color-text-muted)] no-underline hover:text-[var(--color-text)] aria-[current=page]:text-[var(--color-text)]"
                  aria-current={isCurrent ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <ThemeToggle locale={locale} />
  </div>

  <nav aria-label={t('nav.tools')} class="border-t border-[var(--color-rule)] md:hidden">
    <ul
      class="shell flex items-center gap-4 overflow-x-auto py-2 text-[length:var(--text-sm)] whitespace-nowrap"
    >
      {
        primaryLinks.map((link) => (
          <li>
            <a
              href={hrefFor(locale, link.href)}
              class="text-[var(--color-text-muted)] no-underline"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
