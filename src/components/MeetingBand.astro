---
import ZoneSelect from './ZoneSelect.astro';
import { getLocale, type LocaleCode } from '~/config/locales.ts';
import { useTranslations } from '~/lib/i18n/index.ts';
import { buildBand, overlapColumns } from '~/lib/time/band.ts';
import { formatOffsetShort } from '~/lib/time/offset.ts';

/**
 * The 24-hour band, rendered server-side for a labelled example day and rebuilt
 * live by the island. Both use buildBand(), so the shaded hours cannot disagree.
 */
type Props = {
  locale: LocaleCode;
  zones: readonly { timeZone: string; label: string }[];
  seedInstant: number;
};

const { locale, zones, seedInstant } = Astro.props;
const t = useTranslations(locale);
const { hourCycle } = getLocale(locale);

// Columns are instants starting at midnight UTC of the seed day.
const dayStart = Date.UTC(
  new Date(seedInstant).getUTCFullYear(),
  new Date(seedInstant).getUTCMonth(),
  new Date(seedInstant).getUTCDate(),
);

const rows = buildBand(zones, dayStart);
const overlap = overlapColumns(rows);
const seedDate = new Date(dayStart).toISOString().slice(0, 10);

const hourFormatter = new Intl.DateTimeFormat(locale, {
  hour: '2-digit',
  minute: '2-digit',
  hourCycle,
  timeZone: 'UTC',
});

function cellClass(state: 'working' | 'fringe' | 'asleep'): string {
  if (state === 'working') {
    return 'bg-[var(--color-band-working)] border-t-2 border-t-[var(--color-accent)]';
  }
  if (state === 'fringe') return 'bg-[var(--color-band-fringe)]';
  return 'bg-[var(--color-band-asleep)]';
}

const workHourOptions = Array.from({ length: 24 }, (_, hour) => hour);

// Split the sentence around its two placeholders so the island can fill in the
// numbers while the wording and word order stay in the reader's language.
const [overlapLead = '', overlapRest = ''] = t('planner.overlapFound').split('{hours}');
const [overlapMiddle = '', overlapTail = ''] = overlapRest.split('{range}');
---

<meeting-planner
  class="block"
  data-locale={locale}
  data-hour-cycle={hourCycle}
  data-remove-label={t('common.remove')}
>
  <div class="flex flex-wrap items-end gap-4">
    <div class="flex flex-col gap-1">
      <label
        for="planner-date"
        class="text-[length:var(--text-sm)] font-medium text-[var(--color-text-muted)]"
      >
        {t('common.date')}
      </label>
      <input
        id="planner-date"
        data-role="date"
        type="date"
        value={seedDate}
        class="rounded-[var(--radius-md)] border border-[var(--color-rule)] bg-[var(--color-surface-raised)] px-3 py-2 font-[family-name:var(--font-mono)]"
      />
    </div>

    <div class="flex flex-col gap-1">
      <label
        for="planner-work-start"
        class="text-[length:var(--text-sm)] font-medium text-[var(--color-text-muted)]"
      >
        {t('planner.workStart')}
      </label>
      <select
        id="planner-work-start"
        data-role="work-start"
        class="rounded-[var(--radius-md)] border border-[var(--color-rule)] bg-[var(--color-surface-raised)] px-3 py-2"
      >
        {
          workHourOptions.map((hour) => (
            <option value={hour} selected={hour === 9}>
              {String(hour).padStart(2, '0')}:00
            </option>
          ))
        }
      </select>
    </div>

    <div class="flex flex-col gap-1">
      <label
        for="planner-work-end"
        class="text-[length:var(--text-sm)] font-medium text-[var(--color-text-muted)]"
      >
        {t('planner.workEnd')}
      </label>
      <select
        id="planner-work-end"
        data-role="work-end"
        class="rounded-[var(--radius-md)] border border-[var(--color-rule)] bg-[var(--color-surface-raised)] px-3 py-2"
      >
        {
          workHourOptions.map((hour) => (
            <option value={hour + 1} selected={hour + 1 === 18}>
              {String(hour + 1).padStart(2, '0')}:00
            </option>
          ))
        }
      </select>
    </div>
  </div>

  <div class="mt-4">
    <h2 class="text-[length:var(--text-sm)] font-medium text-[var(--color-text-muted)]">
      {t('planner.zones')}
    </h2>
    <ul data-role="zone-list" class="mt-2 flex flex-wrap gap-2">
      {
        zones.map((zone) => (
          <li
            data-zone={zone.timeZone}
            class="flex items-center gap-2 rounded-[var(--radius-md)] border border-[var(--color-rule)] px-2 py-1 text-[length:var(--text-sm)]"
          >
            <span>{zone.label}</span>
          </li>
        ))
      }
    </ul>
    <div class="mt-3 max-w-sm">
      <ZoneSelect
        id="planner-add"
        name="add-zone"
        islandRole="add-zone"
        label={t('planner.addZone')}
        value="UTC"
      />
    </div>
  </div>

  <div
    data-role="summary"
    aria-live="polite"
    class="mt-5 rounded-[var(--radius-md)] bg-[var(--color-surface-sunken)] p-4 text-[length:var(--text-sm)]"
  >
    <p data-summary="window" hidden={overlap.length === 0}>
      {overlapLead}<span data-summary-hours class="tabular font-semibold">{overlap.length}</span>{
        overlapMiddle
      }<span data-summary-range class="tabular font-semibold"></span>{overlapTail}
    </p>
    <p data-summary="none" hidden={overlap.length > 0}>{t('planner.noOverlap')}</p>
  </div>

  <figure class="mt-5">
    <div class="overflow-x-auto">
      <table class="w-full min-w-[52rem] border-collapse">
        <caption
          class="mb-2 text-start text-[length:var(--text-sm)] text-[var(--color-text-muted)]"
        >
          {t('planner.bandCaption')}
        </caption>
        <tbody data-role="grid">
          {
            rows.map((row) => (
              <tr class="border-b border-[var(--color-rule)]">
                <th
                  scope="row"
                  class="sticky start-0 z-10 bg-[var(--color-surface-raised)] py-1 pe-3 text-start font-normal whitespace-nowrap"
                >
                  <span class="block text-[length:var(--text-sm)]">{row.label}</span>
                  <span class="tabular block text-[length:var(--text-2xs)] text-[var(--color-text-muted)]">
                    {formatOffsetShort(row.offsetMinutes)}
                  </span>
                </th>
                {row.cells.map((cell) => (
                  <td
                    class={`tabular border-s border-[var(--color-rule)] px-1 py-1 text-center text-[length:var(--text-2xs)] ${cellClass(cell.state)}`}
                    title={
                      cell.dayDelta === 0
                        ? undefined
                        : `${cell.dayDelta > 0 ? '+' : ''}${cell.dayDelta} day`
                    }
                  >
                    {hourFormatter.format(new Date(Date.UTC(2026, 0, 1, cell.hour, cell.minute)))}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <figcaption class="mt-2 text-[length:var(--text-xs)] text-[var(--color-text-muted)]">
      {t('planner.example')}: {seedDate}. {t('note.exampleTimestamp')}
    </figcaption>
  </figure>
</meeting-planner>

<script>
  import '~/islands/meeting-planner.ts';
</script>
