{
  "name": "meridiem",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "YourWorldTime — time zone conversion, meeting planning and world clock tools. Static, zero backend.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "astro build",
    "check": "astro check",
    "dev": "astro dev",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gate": "npm run check && npm run lint && npm run format:check && npm run audit:sethtml && npm run test:coverage && npm run build && npm run audit:i18n && npm run audit:i18nleak && npm run audit:links && npm run audit:seo && npm run audit:html && npm run audit:islands && npm run audit:headers && npm run audit:js",
    "icons": "node scripts/make-icons.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "astro preview",
    "serve": "node scripts/serve-dist.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "audit:headers": "node scripts/audit-headers.mjs",
    "audit:html": "node scripts/html-validate.mjs",
    "audit:i18n": "node scripts/i18n-parity.mjs",
    "audit:i18nleak": "node scripts/i18n-leak.mjs",
    "audit:islands": "node scripts/island-audit.mjs",
    "audit:js": "node scripts/js-budget.mjs",
    "audit:links": "node scripts/link-check.mjs",
    "audit:seo": "node scripts/seo-audit.mjs",
    "audit:sethtml": "node scripts/audit-set-html.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "5.3.0",
    "@fontsource/ibm-plex-sans-devanagari": "5.3.0",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.2.4",
    "satori": "0.29.1",
    "tailwindcss": "4.3.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@typescript-eslint/parser": "8.67.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.8.1",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "globals": "16.5.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
